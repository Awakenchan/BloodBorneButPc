+                        return num_read_watchers;
+                    }
+                    return ++num_read_watchers;
+                } else if (delta == -1) {
+                    if (num_read_watchers == 0) [[unlikely]] {
+                        NoteWatcherCount(page, "not enough read watchers");
+                        return 0;
+                    }
