+    };
+    for (const auto& [from, to] : kShort) {
+        if (from == name) {
+            return to;
+        }
+    }
+    std::string label = name;
+    if (label.rfind("Keypad ", 0) == 0) {
+        label = "Num" + label.substr(7);
+    }
+    return label.size() > 5 ? label.substr(0, 5) : label;
