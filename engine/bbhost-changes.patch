+        const std::string& npid = r.npid();
+        const size_t cp = std::min<size_t>(npid.size(), sizeof(out.rankData.npId.handle.data));
+        std::memcpy(out.rankData.npId.handle.data, npid.data(), cp);
+        out.rankData.npId.handle.term = 0;
