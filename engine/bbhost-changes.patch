-        }
-
-        p.room_bin_attrs.resize(changed_attrs.size());
-        p.bin_buffers.clear();
-        p.bin_buffers.reserve(changed_attrs.size());
-        for (size_t i = 0; i < changed_attrs.size(); ++i) {
-            const auto& src = changed_attrs[i];
