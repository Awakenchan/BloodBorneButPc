-template <typename... Parts>
-VideoCore::ImageId Rasterizer::FindTargetMemoized(VideoCore::TextureCache::ImageDesc& desc,
-                                                  LastTarget& last, auto&& make_desc,
-                                                  const Parts&... parts) {
-    static_assert((sizeof(Parts) + ...) <= 256, "target memo key too large");
