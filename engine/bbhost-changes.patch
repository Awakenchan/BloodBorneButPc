+static bool ComputeOffset(Xbyak::CodeGenerator& c, Xbyak::Reg32 reg, PassInfo& pass_info,
+                          const IR::Value& off_dw);
+
+#define ABORT_ON_FAILURE(expr)                                                                     \
+    if (!(expr)) {                                                                                 \
+        return false;                                                                              \
+    }
+
+#define POP_ABORT_ON_FAILURE(expr)                                                                 \
+    if (!(expr)) {                                                                                 \
+        c.add(rsp, 8);                                                                             \
+        return false;                                                                              \
+    }
