+u64 CountFailure(std::string_view function, int e) {
+    static std::mutex mutex;
+    static std::map<std::pair<std::string, int>, u64> counts;
+    std::scoped_lock lock{mutex};
+    return ++counts[{std::string{function}, e}];
+}
