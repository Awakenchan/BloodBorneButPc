+bool IsContextLifecycleEvent(OrbisNpMatching2Event event) {
+    return event == ORBIS_NP_MATCHING2_CONTEXT_EVENT_STARTED ||
+           event == ORBIS_NP_MATCHING2_CONTEXT_EVENT_STOPPED;
+}
