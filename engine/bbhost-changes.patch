+// SDL/Pad bridge for bbhost's native engine mouse camera and menu hit testing.
+#include "input.h"
+#include "compat.h"
+#include "bindings.h"
+#include "ini_bindings.h"
+#include "mouse_camera_step.h"
+#include "../bbport_settings.h"
