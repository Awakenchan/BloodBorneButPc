+static_assert(offsetof(OrbisNpCalloutContext, active) == 0x18);
+static_assert(offsetof(OrbisNpCalloutContext, stop_requested) == 0x1c);
+static_assert(offsetof(OrbisNpCalloutContext, head) == 0x20);
