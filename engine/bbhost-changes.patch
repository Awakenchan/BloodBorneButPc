+        if (r.groups_size() > 0) {
+            OrbisNpMatching2RoomGroupInfo* first = nullptr;
+            for (int g = 0; g < r.groups_size(); ++g) {
+                const auto& src = r.groups(g);
+                auto& gi = p.ext_room_groups.emplace_back();
+                gi = OrbisNpMatching2RoomGroupInfo{};
