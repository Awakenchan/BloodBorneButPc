+        break;
+    case ORBIS_NET_IPPROTO_UDP:
+        level_name = "IPPROTO_UDP";
+        if (name == ORBIS_NET_UDP_SND_ON_SUSPEND) {
+            option = "UDP_SND_ON_SUSPEND";
