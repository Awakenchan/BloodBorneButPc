+                  dst.externalSearchBinAttrs);
+        build_bin(r.external_bin_attrs(), dst.externalBinAttr, dst.externalBinAttrs);
+    }
+
+    p.room_data_external_list_response =
+        std::make_unique<OrbisNpMatching2GetRoomDataExternalListResponse>();
