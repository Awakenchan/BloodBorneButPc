+        }
+        bool done = false;
+        SpilledWatchers* free_entry = nullptr;
+        for (auto& entry : spilled_watchers) {
+            if (entry.extra != 0 && entry.page == page) {
+                entry.extra += delta;
+                done = true;
+                break;
+            }
+            if (entry.extra == 0 && !free_entry) {
+                free_entry = &entry;
+            }
+        }
+        if (!done && delta > 0 && free_entry) {
+            *free_entry = {page, 1};
+            done = true;
+        }
+        spill_lock.clear(std::memory_order_release);
+        return done;
+    }
