+                for (int c=0;c<8;++c) {
+                    if (p->is_float) memcpy(&s[c],converted+(f*8+(size_t)c)*4,4);
+                    else { int16_t v; memcpy(&v,converted+(f*8+(size_t)c)*2,2); s[c]=(float)v; }
+                }
+                const float lr[2]={s[0]+k*(s[2]+s[4]+s[6]), s[1]+k*(s[2]+s[5]+s[7])};
+                for (int c=0;c<2;++c) {
+                    if (p->is_float) {
