+    if (auto it = g_state.connections.find(id); it != g_state.connections.end()) {
+        epoll_id_out = &it->second.epoll_id;
+        user_arg_out = &it->second.epoll_user_arg;
+        level = "connection";
+        return true;
+    }
+    if (auto it = g_state.requests.find(id); it != g_state.requests.end()) {
+        epoll_id_out = &it->second->epoll_id;
+        user_arg_out = &it->second->epoll_user_arg;
+        level = "request";
+        return true;
+    }
+    return false;
