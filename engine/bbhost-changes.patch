+namespace {
+std::mutex g_dns_mutex;
+std::array<u32, 2> g_dns_override{};
+std::array<u8, 32> g_dns6_override{};
+
+bool IsZero(std::span<const u8> bytes) {
+    return std::all_of(bytes.begin(), bytes.end(), [](u8 b) { return b == 0; });
+}
