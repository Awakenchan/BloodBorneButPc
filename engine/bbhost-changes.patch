+void ReleaseResolverPool(OrbisNetId rid) {
+    std::scoped_lock lock{g_pools_mutex};
+    if (const auto it = g_resolver_pools.find(rid); it != g_resolver_pools.end()) {
+        if (Pool* pool = FindPool(it->second)) {
+            --pool->users;
+        }
+        g_resolver_pools.erase(it);
+    }
+}
