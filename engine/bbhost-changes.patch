+    const auto r = Core::Net::SocketGetPeerName(s, reinterpret_cast<sockaddr*>(&host), &host_len);
+    if (r.error == Error::Ok) {
+        ToOrbisSockaddr(reinterpret_cast<sockaddr*>(&host), host_len, addr, paddrlen);
