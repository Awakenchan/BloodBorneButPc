+void NpHandler::FireStateCallback(s32 user_id, NpManager::OrbisNpState state) {
+    std::lock_guard lock(m_mutex_cbs);
+    for (const auto& e : m_state_cbs) {
+        if (e.cb)
+            e.cb(user_id, state);
+    }
+}
