+            w->maxNumOfRoom = 1000;
+            w->numOfRoom = 1000;
+            resp->world = w;
+            resp->worldNum = 1;
+            c = request_call(o.cbFunc, o.cbFuncArg, req, kEvGetWorldInfoList, 0, resp);
+        }
+        c.run();
+    });
