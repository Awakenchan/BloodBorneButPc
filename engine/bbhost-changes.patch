+// SPDX-License-Identifier: GPL-2.0-or-later
+// Pipeline compiles off the frame path (docs/pipeline_compiles.md): the compile job queue a
+// waiting thread takes its job from, the bound on leaving draws out, the texture cache's
+// lock-free page watch counts, and the draw pipe's sleeping waits (no Vulkan device).
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <thread>
+#include <vector>
+
+#include "bbport_platform.h"
+#include "video_core/renderer_vulkan/pipeline_compile_queue.h"
+#include "video_core/renderer_vulkan/vk_draw_pipe.h"
+#include "video_core/texture_cache/watched_pages.h"
+
+using namespace std::chrono_literals;
+
+namespace {
+
+void TestJobQueue() {
+    Vulkan::PipelineJobQueue queue;
+    int a = 0, b = 0, c = 0;
+    std::vector<char> order;
+    queue.Push(&a, [&] { order.push_back('a'); });
+    queue.Push(&b, [&] { order.push_back('b'); });
+    queue.Push(&c, [&] { order.push_back('c'); });
+    assert(queue.Size() == 3);
+    // A thread that needs b takes it out of the queue and runs it itself.
+    auto job = queue.Take(&b);
+    assert(job);
+    job();
+    assert(!queue.Take(&b)); // gone: a second waiter waits for the first one's result
+    assert(queue.Size() == 2);
+    // The compile threads go on first in, first out with the rest.
+    queue.Pop()();
+    queue.Pop()();
+    assert((order == std::vector<char>{'b', 'a', 'c'}));
+    assert(!queue.Take(&a) && queue.Size() == 0);
+
+    // A compile thread and takers at once: every job runs exactly once.
+    constexpr int Jobs = 2000;
+    std::vector<int> owners(Jobs);
+    std::vector<std::atomic<int>> runs(Jobs);
+    for (int i = 0; i < Jobs; ++i) {
+        queue.Push(&owners[i], [&, i] {
+            runs[i].fetch_add(1);
+            std::this_thread::yield();
+        });
+    }
+    std::atomic<bool> stop{false};
+    std::thread worker([&] {
+        while (!stop.load()) {
+            queue.Pop()();
+        }
+    });
+    for (int i = Jobs - 1; i >= 0; i -= 3) {
+        if (auto j = queue.Take(&owners[i])) {
+            j();
+        }
+    }
+    // Last in the queue: the compile thread has run every job left before it.
+    queue.Push(nullptr, [&] { stop.store(true); });
+    worker.join();
+    assert(queue.Size() == 0);
+    for (int i = 0; i < Jobs; ++i) {
+        assert(runs[i].load() == 1);
+    }
+}
+
+void TestSkipBudget() {
+    using Vulkan::WithinSkipBudget;
+    constexpr std::uint64_t Ms = 1'000'000;
+    std::uint64_t first = 0;
+    assert(WithinSkipBudget(first, 5 * Ms, 1000 * Ms) && first == 5 * Ms);
+    assert(WithinSkipBudget(first, 500 * Ms, 1000 * Ms) && first == 5 * Ms);
+    assert(WithinSkipBudget(first, 1004 * Ms, 1000 * Ms));
+    assert(!WithinSkipBudget(first, 1005 * Ms, 1000 * Ms)); // waits from then on
+    assert(!WithinSkipBudget(first, 9000 * Ms, 1000 * Ms));
+    std::uint64_t never = 0;
+    assert(!WithinSkipBudget(never, 7 * Ms, 0)); // BB_SKIP_UNCOMPILED=0
+    std::uint64_t at_zero = 0;
+    assert(WithinSkipBudget(at_zero, 0, 10) && at_zero != 0);
+}
+
+void TestWatchedPages() {
+    auto pages = std::make_unique<VideoCore::WatchedPages>();
+    constexpr std::uint64_t P = 4096;
+    const std::uint64_t base = 0x2'4000'0000ull; // another chunk than below
+    assert(!pages->Any(base, 8));
+    // An image over three pages, not page aligned (TrackImage: the whole image).
+    const std::uint64_t begin = base + 0x800, end = base + 2 * P + 0x100;
+    pages->Add(begin, end - begin, 1);
+    assert(pages->Any(base, 8) && pages->Any(base + P, 8) && pages->Any(base + 2 * P + 0xff0, 8));
+    assert(!pages->Any(base + 3 * P, 8) && !pages->Any(base - 8, 8));
+    // UntrackImageHead: [begin, next page), then UntrackImageTail: [page of end, end): the
+    // counts follow the page manager's (each sub-range's own pages).
+    pages->Add(begin, base + P - begin, -1);
+    assert(!pages->Any(base + 0x900, 8) && pages->Any(base + P, 8));
+    pages->Add(base + 2 * P, end - (base + 2 * P), -1);
+    assert(!pages->Any(base + 2 * P + 8, 8) && pages->Any(base + P + 8, 8));
+    // A second image sharing the middle page keeps it watched after the first one goes.
+    pages->Add(base + P + 0x200, 0x100, 1);
+    pages->Add(base + P, P, -1); // UntrackImage of what is left of the first
+    assert(pages->Any(base + P, 8));
+    pages->Add(base + P + 0x200, 0x100, -1);
+    assert(!pages->Any(base, 3 * P));
+    // A range across pages, and a page-aligned tail of size 0 (no page), as the page manager.
+    pages->Add(base + 5 * P, 0, -1);
+    assert(!pages->Any(base + 5 * P, 1));
+    // Addresses past the table count as watched (the locked path).
+    assert(pages->Any(std::uint64_t{1} << 41, 8));
+    // Untracking more than tracked stays at zero instead of wrapping.
+    pages->Add(base + 9 * P, P, -1);
+    assert(!pages->Any(base + 9 * P, 8));
+}
+
+// The draw pipe's stage A waits: packets that run long (a pipeline compile, an image created
+// with memory short) must not keep stage A spinning, and a wake-up must never be lost.
+std::atomic<int> long_packets{0};
+std::atomic<std::uint64_t> handled{0};
+void Handler(void*, const u8* packet, u32 size) {
+    u32 sleep_ms = 0;
+    std::memcpy(&sleep_ms, packet, sizeof(sleep_ms));
+    if (sleep_ms) {
+        long_packets.fetch_add(1);
+        std::this_thread::sleep_for(std::chrono::milliseconds(sleep_ms));
+    }
+    assert(size == sizeof(u32));
+    handled.fetch_add(1, std::memory_order_relaxed);
+}
+
+void Post(Vulkan::DrawPipe& pipe, u32 sleep_ms) {
+    u8* out = pipe.Begin(sizeof(u32));
+    std::memcpy(out, &sleep_ms, sizeof(sleep_ms));
+    pipe.Commit(sizeof(u32));
+}
+
+std::uint64_t ThreadCpuUs() {
+    BbPlatform::Usage usage;
+    return BbPlatform::GetUsage(true, usage) ? usage.user_us + usage.sys_us : 0;
+}
+
+void TestDrawPipeWaits() {
+    Vulkan::DrawPipe pipe(&Handler, nullptr);
+    // A drain behind a 300 ms packet: stage A sleeps (stage B wakes it), using little CPU.
+    Post(pipe, 0);
+    Post(pipe, 300);
+    const std::uint64_t cpu_before = ThreadCpuUs();
+    const auto start = std::chrono::steady_clock::now();
+    pipe.Drain();
+    const auto waited = std::chrono::steady_clock::now() - start;
+    const std::uint64_t cpu_us = ThreadCpuUs() - cpu_before;
+    assert(pipe.Idle() && handled.load() == 2);
+    assert(waited >= 250ms);
+    std::printf("drain behind a 300 ms packet: waited %lld ms, %llu us on the CPU, %llu sleeps\n",
+                static_cast<long long>(
+                    std::chrono::duration_cast<std::chrono::milliseconds>(waited).count()),
+                static_cast<unsigned long long>(cpu_us),
+                static_cast<unsigned long long>(pipe.sleeps));
+    if (Vulkan::DrawPipe::SleepEnabled()) {
+        assert(pipe.sleeps >= 1);
+        // Spin (4096 pauses) and yield for 0.5 ms, then asleep: far below the 300 ms.
+        assert(cpu_us < 60'000);
+    }
+
+    // WaitForPacket for one in the middle of long ones.
+    const u64 number = pipe.NextPacket() + 1;
+    Post(pipe, 20);
+    Post(pipe, 20);
+    Post(pipe, 200);
+    pipe.WaitForPacket(number, Vulkan::DrawPipe::ReasonConstRam);
+    assert(pipe.ReachedPacket(number));
+    pipe.Drain();
+
+    // Many short packets with drains and packet waits in between, a watchdog for a lost
+    // wake-up (stage A asleep with nothing left for stage B to run: a hang).
+    std::atomic<bool> finished{false};
+    std::thread watchdog([&] {
+        std::uint64_t last = handled.load();
+        for (int quiet = 0; !finished.load(); std::this_thread::sleep_for(100ms)) {
+            const std::uint64_t now = handled.load();
+            quiet = now == last ? quiet + 1 : 0;
+            last = now;
+            if (quiet > 100) {
+                std::fprintf(stderr, "draw pipe wait hung (lost wake-up)\n");
+                std::abort();
+            }
+        }
+    });
+    std::uint64_t rng = 0x9e3779b97f4a7c15ull;
+    for (int i = 0; i < 20000; ++i) {
+        rng ^= rng << 13;
+        rng ^= rng >> 7;
+        rng ^= rng << 17;
+        Post(pipe, (rng & 1023) == 0 ? 2 : 0);
+        switch (rng >> 61) {
+        case 0:
+            pipe.Drain();
+            assert(pipe.Idle());
+            break;
+        case 1:
+            pipe.WaitForPacket(pipe.NextPacket() - 1, Vulkan::DrawPipe::ReasonRasterizer);
+            break;
+        default:
+            break;
+        }
+    }
+    pipe.Drain();
+    finished.store(true);
+    watchdog.join();
+    assert(pipe.Idle() && handled.load() == pipe.packets);
+    std::printf("%llu packets, %llu drains that waited, %llu slept, %d long packets\n",
+                static_cast<unsigned long long>(pipe.packets),
+                static_cast<unsigned long long>(pipe.drains),
+                static_cast<unsigned long long>(pipe.sleeps), long_packets.load());
+}
+
+} // namespace
+
+int main() {
+    TestJobQueue();
+    TestSkipBudget();
+    TestWatchedPages();
+    TestDrawPipeWaits();
+    std::printf("pipeline compile tests passed\n");
+    return 0;
+}
diff --git a/tests/test_redzone.py b/tests/test_redzone.py
new file mode 100644
index 0000000..b7ddf6c
--- /dev/null
+++ b/tests/test_redzone.py
@@ -0,0 +1,136 @@
+"""Red-zone-safe trampolines for guest stores (link_modules.protect_red_zones).
+
+Where Windows saves extended state in the compact XSAVE layout (Intel 12th gen and later), a
+fault's frame holds the AVX registers up to 0x28 bytes below rsp, over the System V red zone, so
+a guest leaf function whose store faults on a GPU-tracked page loses its locals (the
+attack-trail crash at 0x28ce9b5). The Windows test runs that sequence for real: a vectored
+handler unprotects the page as the GPU tracker does.
+"""
+from paths import ROOT
+import ctypes
+import json
+import os
+import struct
+import unittest
+import xml.etree.ElementTree as ET
+from link_modules import LEA_DOWN, LEA_UP, protect_red_zones
+
+SENTINEL = 0x1122334455667788
+STORE = 30  # offset of the faulting store in leaf()
+
+
+def leaf(page):
+    """vcmptrueps ymm0 (AVX state in use); mov rax,SENTINEL; mov [rsp-0x40],rax; mov rcx,page;
+    mov dword [rcx],1; mov rax,[rsp-0x40]; vzeroupper; ret"""
+    code = (bytes.fromhex('c5fcc2c00f') + b'\x48\xb8' + struct.pack('<Q', SENTINEL) +
+            bytes.fromhex('48894424c0') + b'\x48\xb9' + struct.pack('<Q', page) +
+            bytes.fromhex('c70101000000') + bytes.fromhex('488b4424c0' 'c5f877' 'c3'))
+    return code, [[STORE, 'c70101000000', [-6]]]
+
+
+class TrampolineBytes(unittest.TestCase):
+    def test_site_jumps_to_trampoline_that_lowers_rsp_around_the_store(self):
+        image = bytearray(leaf(0)[0])
+        code, applied = protect_red_zones(image, leaf(0)[1], 0x100)
+        self.assertEqual(applied, 1)
+        self.assertEqual(image[STORE:STORE + 5], b'\xe9' + struct.pack('<i', 0x100 - (STORE + 5)))
+        self.assertEqual(image[STORE + 5], 0xcc)
+        body = LEA_DOWN + bytes.fromhex('c70101000000') + LEA_UP
+        self.assertEqual(code[:len(body)], body)
+        back = 0x100 + len(body) + 5
+        self.assertEqual(code[len(body):len(body) + 5], b'\xe9' + struct.pack('<i', STORE + 6 - back))
+
+    def test_other_instructions_of_a_site_are_copied_unchanged(self):
+        image = bytearray(bytes.fromhex('8b442404' '8946a4' 'c3'))  # mov eax,[rsp+4]; mov [rsi-0x5c],eax
+        code, applied = protect_red_zones(image, [[0, '8b4424048946a4', [4, -3]]], 0x40)
+        self.assertEqual(applied, 1)
+        self.assertTrue(code.startswith(bytes.fromhex('8b442404') + LEA_DOWN + bytes.fromhex('8946a4') + LEA_UP))
+
+    def test_changed_bytes_or_relocations_leave_the_site_alone(self):
+        image = bytearray(leaf(0)[0])
+        self.assertEqual(protect_red_zones(image, [[STORE, 'c70102000000', [-6]]], 0x100), (b'', 0))
+        self.assertEqual(protect_red_zones(image, leaf(0)[1], 0x100, skip=[STORE + 3]), (b'', 0))
+        self.assertEqual(image, leaf(0)[0])
+
+
+class SiteTable(unittest.TestCase):
+    sites = json.loads((ROOT / 'patches' / 'redzone.json').read_text())['sites']
+
+    def test_attack_trail_stores_are_covered(self):
+        # 0x28ce7b0 writes trail vertices with live locals at [rsp-0x6c, rsp); 0x28ce9b5 then
+        # loaded a NULL pointer from the overwritten [rsp-0x60].
+        covered = set()
+        for offset, original, lengths in self.sites:
+            pos = offset
+            for length in lengths:
+                if length < 0:
+                    covered.add(pos)
+                pos += abs(length)
+        for store in (0x28cedfe, 0x28cee33, 0x28cee68, 0x28cee72):
+            self.assertIn(store, covered)
+
+    def test_sites_do_not_overlap_community_patches(self):
+        lines = ET.parse(ROOT / 'patches' / 'Bloodborne.xml').iter('Line')
+        patched = sorted(int(line.get('Address'), 16) - 0x400000 for line in lines)
+        for offset, original, _ in self.sites:
+            end = offset + len(original) // 2
+            self.assertFalse(any(offset - 8 < p < end for p in patched), hex(offset))
+
+
+@unittest.skipUnless(os.name == 'nt', 'Windows exception dispatch')
+class WindowsFault(unittest.TestCase):
+    """A store faults on a read-only page; the handler makes it writable and resumes."""
+
+    def run_leaf(self, protect):
+        k32 = ctypes.WinDLL('kernel32', use_last_error=True)
+        k32.VirtualAlloc.restype = ctypes.c_void_p
+        k32.VirtualAlloc.argtypes = (ctypes.c_void_p, ctypes.c_size_t, ctypes.c_uint32, ctypes.c_uint32)
+        k32.VirtualProtect.argtypes = (ctypes.c_void_p, ctypes.c_size_t, ctypes.c_uint32, ctypes.POINTER(ctypes.c_uint32))
+        k32.VirtualFree.argtypes = (ctypes.c_void_p, ctypes.c_size_t, ctypes.c_uint32)
+        k32.AddVectoredExceptionHandler.restype = ctypes.c_void_p
+        k32.RemoveVectoredExceptionHandler.argtypes = (ctypes.c_void_p,)
+        page = k32.VirtualAlloc(None, 4096, 0x3000, 0x02)  # MEM_COMMIT|MEM_RESERVE, PAGE_READONLY
+        text = k32.VirtualAlloc(None, 4096, 0x3000, 0x40)  # PAGE_EXECUTE_READWRITE
+        code, sites = leaf(page)
+        image = bytearray(code)
+        if protect:
+            trampolines, applied = protect_red_zones(image, sites, 0x100)
+            self.assertEqual(applied, 1)
+            image += bytes(0x100 - len(image)) + trampolines
+        ctypes.memmove(text, bytes(image), len(image))
+
+        class Record(ctypes.Structure):
+            _fields_ = [('code', ctypes.c_uint32), ('flags', ctypes.c_uint32), ('next', ctypes.c_void_p),
+                        ('address', ctypes.c_void_p), ('count', ctypes.c_uint32),
+                        ('information', ctypes.c_size_t * 15)]
+
+        class Pointers(ctypes.Structure):
+            _fields_ = [('record', ctypes.POINTER(Record)), ('context', ctypes.c_void_p)]
+
+        @ctypes.WINFUNCTYPE(ctypes.c_long, ctypes.POINTER(Pointers))
+        def handler(info):
+            r = info.contents.record.contents
+            if r.code != 0xC0000005 or not page <= r.information[1] < page + 4096:
+                return 0  # EXCEPTION_CONTINUE_SEARCH
+            k32.VirtualProtect(page, 4096, 0x04, ctypes.byref(ctypes.c_uint32()))
+            return -1  # EXCEPTION_CONTINUE_EXECUTION
+
+        cookie = k32.AddVectoredExceptionHandler(1, handler)
+        try:
+            result = ctypes.CFUNCTYPE(ctypes.c_uint64)(text)()
+        finally:
+            k32.RemoveVectoredExceptionHandler(cookie)
+            k32.VirtualFree(text, 0, 0x8000)
+            k32.VirtualFree(page, 0, 0x8000)
+        return result
+
+    def test_exception_frame_overwrites_the_red_zone(self):
+        if self.run_leaf(protect=False) == SENTINEL:
+            self.skipTest('this CPU keeps the red zone: its AVX state is saved further down')
+
+    def test_trampoline_keeps_the_red_zone(self):
+        self.assertEqual(self.run_leaf(protect=True), SENTINEL)
+
+
+if __name__ == '__main__':
+    unittest.main()
