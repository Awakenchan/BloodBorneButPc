+void RemoveConnectionLocked(s32 conn_id) {
+    const auto it = NpHandler::GetInstance().GetSignalingState().connections.find(conn_id);
+    if (it == NpHandler::GetInstance().GetSignalingState().connections.end()) {
+        return;
