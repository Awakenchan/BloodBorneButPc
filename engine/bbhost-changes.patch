+    vk::Device device;
+    vk::Queue queue;
+    VmaAllocator allocator;
+    vk::UniqueCommandPool pool;
+    vk::CommandBuffer cmdbuf;
+    vk::UniqueFence fence;
+    VkBuffer buffer = VK_NULL_HANDLE;
+    VmaAllocation allocation = nullptr;
+    u8* mapped = nullptr;
+    u64 capacity = 0;
