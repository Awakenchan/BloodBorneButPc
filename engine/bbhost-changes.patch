+void CopyNpHandle(OrbisNpId& dst, const std::string& src) {
+    dst = OrbisNpId{};
+    const size_t cp = std::min(src.size(), sizeof(dst.handle.data) - 1);
+    std::memcpy(dst.handle.data, src.data(), cp);
+}
