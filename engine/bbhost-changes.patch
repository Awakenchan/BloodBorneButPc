+u64 TwinsMaxBytes() {
+    static const u64 max_bytes = [] {
+        const char* env = std::getenv("BB_GPU_WRITE_TWINS_MAX");
+        return env ? std::strtoull(env, nullptr, 10) : 1024ull;
