+    /// returns the host copy, or null on failure (the caller takes the regular path).
+    const u8* Copy(const Buffer* arena, std::span<const vk::BufferCopy> copies, u64 total,
+                   vk::Semaphore semaphore, u64 tick) {
+        if (!Ensure(total)) {
