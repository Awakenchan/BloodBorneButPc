+    if (n>=20 && !memcmp(sfo,"\0PSF",4)) {
+        const uint32_t keys=le32(sfo+8), data=le32(sfo+12), count=le32(sfo+16);
+        for (uint32_t i=0;i<count && 20+16*((size_t)i+1)<=n && !found;++i) {
