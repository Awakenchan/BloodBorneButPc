+typedef struct {
+    float pixel_density; uint16_t resolution_x, resolution_y;
+    uint8_t dead_zone_left, dead_zone_right, connection_type, connected_count;
+    uint8_t connected, pad[3];
+    int32_t device_class;
+    uint8_t reserve[8];
