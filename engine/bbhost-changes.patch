-        last = now;
-        // Stall diagnostics: what happened during a long frame.
-        static u64 last_gpu_ns, last_images, last_image_bytes, last_buffer_bytes;
-        static u64 last_t[6], last_minflt, last_sigf, last_pc, last_pp, last_rc, last_rp;
