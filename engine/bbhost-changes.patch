+    u32 evict_reports = 0, dma_kept_reports = 0, dma_kept_second = 0;
+    /// The seconds a VRAM copy may go unused before it goes back in place, at this level.
+    u32 idle_seconds_now = 60;
     u32 block_size{};
     u32 block_shift{};
     u32 blocks_per_arena_page{};
