-echo "GPU library: PGO $pgo, LTO ${BB_LTO:-ON}"
+# A plain source copy (no submodule checkout) already has them applied.
+if [[ -e gpu/third_party/fsr-vulkan/.git ]]; then
+    for patch in gpu/patches/fsr-vulkan/*.patch; do
