+        {WSAEDESTADDRREQ, Error::DestAddrReq},
+        {WSAEMSGSIZE, Error::MsgSize},
+        {WSAEPROTOTYPE, Error::ProtoType},
+        {WSAENOPROTOOPT, Error::NoProtoOpt},
