+            int target=p->channels==8 && !p->std_layout ? remap[c] : c;
+            size_t from=f*(size_t)p->channels+(size_t)c, to=f*(size_t)p->channels+(size_t)target;
+            float gain=(float)p->volume[c]/VOLUME_0DB;
