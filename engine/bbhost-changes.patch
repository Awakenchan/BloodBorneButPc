-
-    char* block = nullptr;
-    u64 blockSize = 0;
-    const s32 httpReqId = getHttpRequestIdFromRequest(request);
-    const s32 err = Libraries::Http::sceHttpGetAllResponseHeaders(httpReqId, &block, &blockSize);
