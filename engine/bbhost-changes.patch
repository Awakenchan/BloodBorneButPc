+OrbisNpMatching2RoomGroup* FindPayloadGroup(CallbackPayload& p, OrbisNpMatching2RoomGroupId id) {
+    for (auto& group : p.room_groups) {
+        if (group.id == id) {
+            return &group;
+        }
+    }
+    return nullptr;
+}
