+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: real occlusion query results (vk_occlusion.h). Design after droogie/bbhost b68ed17.
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "bbport_toggles.h"
