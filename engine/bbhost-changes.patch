-static int ConvertLevels(int level) {
-    switch (level) {
-    case ORBIS_NET_SOL_SOCKET:
-        return SOL_SOCKET;
-    case ORBIS_NET_IPPROTO_IP:
-        return IPPROTO_IP;
-    case ORBIS_NET_IPPROTO_TCP:
-        return IPPROTO_TCP;
-    case ORBIS_NET_IPPROTO_IPV6:
-        return IPPROTO_IPV6;
-    }
-    return -1;
-}
