-        hostScanLen = 1;
-        while (true) {
-            if (hostScanLen == 0xff) {
-                return ORBIS_HTTP_ERROR_INVALID_URL;
-            }
-            const unsigned char c = static_cast<unsigned char>(hostStart[hostScanLen]);
