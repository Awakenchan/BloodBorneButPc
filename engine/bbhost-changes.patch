+            barrier(hdr_overlay.image, Layout::eColorAttachmentOptimal,
+                    Layout::eShaderReadOnlyOptimal, Stage::eColorAttachmentOutput,
+                    Access::eColorAttachmentWrite, Stage::eFragmentShader,
+                    Access::eShaderSampledRead),
