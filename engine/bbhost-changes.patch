-                rasterizer->SignalAfterGpu(
-                    [release, pipe_id] {
-                        release.SignalFence(
-                            [pipe_id] {
-                                Platform::IrqC::Instance()->Signal(
-                                    static_cast<Platform::InterruptId>(pipe_id));
-                            },
-                            [](VAddr, u16, u16) {});
