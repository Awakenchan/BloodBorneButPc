-        if (pValueLength != nullptr)
-            *pValueLength = found ? value.size() : 0;
-        if (pValue != nullptr && valueSize > 0) {
-            const u64 n = found ? std::min<u64>(value.size(), valueSize - 1) : 0;
-            if (n > 0)
-                std::memcpy(pValue, value.data(), n);
-            pValue[n] = '\0';
