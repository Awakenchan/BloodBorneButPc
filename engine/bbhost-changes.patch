+    case ORBIS_NET_IPPROTO_TCP:
+        level_name = "IPPROTO_TCP";
+        switch (name) {
+        case ORBIS_NET_TCP_NODELAY:
+            option = "TCP_NODELAY";
+            break;
+        case ORBIS_NET_TCP_MAXSEG:
