-    unsigned a, b, c, d, leaf1_c = 0, leaf7_b = 0, ext1_c = 0;
-    if (__get_cpuid(1, &a, &b, &c, &d)) leaf1_c = c;
-    if (__get_cpuid_count(7, 0, &a, &b, &c, &d)) leaf7_b = b;
-    if (__get_cpuid(0x80000001u, &a, &b, &c, &d)) ext1_c = c;
