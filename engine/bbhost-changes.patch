+        Vulkan::Check(cmdbuf.end());
+        const vk::SemaphoreSubmitInfo wait{
+            .semaphore = semaphore,
+            .value = tick,
+            .stageMask = vk::PipelineStageFlagBits2::eTransfer,
+        };
