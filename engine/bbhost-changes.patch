+s32 NpHandler::GetUserIdByAccountId(u64 account_id) const {
+    std::lock_guard lock(m_mutex_clients);
+    for (auto& [uid, client] : m_clients) {
+        if (static_cast<u64>(client->GetUserId()) == account_id)
+            return uid;
+    }
+    return -1;
+}
