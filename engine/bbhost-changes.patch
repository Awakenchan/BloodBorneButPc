+bool UserContext::HasBusyRequests() {
+    this->Lock();
+    for (auto& [request_id, request] : this->requests) {
+        request->AddUser();
+        bool busy = request->IsBusy();
+        request->RemoveUser();
+        if (busy) {
+            this->Unlock();
+            return true;
+        }
+    }
+    this->Unlock();
+    return false;
+}
