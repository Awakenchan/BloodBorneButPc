-            lockContext(context);
-            handle->userCount++;
-        }
-        handle->userCount--;
-    } else if (handle->userCount > 0) {
-        unlockContext(context);
-        return ORBIS_NP_WEBAPI_ERROR_HANDLE_BUSY;
-    }
-
-    context->handles.erase(handleId);
-
