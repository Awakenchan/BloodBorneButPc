+void BufferCache::UpdateVramLevel(u32 now) {
+    static const u64 percent = [] {
+        const char* env = std::getenv("BB_VRAM_PRESSURE_PERCENT");
+        return std::min<u64>(env ? std::strtoull(env, nullptr, 10) : 85, 95);
