-bool IsDirectDraw(AmdGpu::PM4ItOpcode opcode) {
-    using AmdGpu::PM4ItOpcode;
-    return opcode == PM4ItOpcode::DrawIndex2 || opcode == PM4ItOpcode::DrawIndexOffset2 ||
-           opcode == PM4ItOpcode::DrawIndexAuto;
-}
