-u32 BufferCache::VramIdleSeconds() {
-    static const u32 seconds = [] {
-        const char* env = std::getenv("BB_VRAM_IDLE_SECONDS");
-        return env ? u32(std::strtoul(env, nullptr, 10)) : 60u;
