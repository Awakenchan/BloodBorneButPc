-bool input_blocked() {
-    std::uint64_t a = 0, b = 0;
-    if (safe_read(guest(kMenuFlow), &a, sizeof(a)) && a) {
-        std::uint64_t v = 0;
-        if (safe_read(a + 0xa78, &v, sizeof(v)) && v) {
-            return true;
-        }
-    }
-    if (safe_read(guest(kInputBlockB), &b, sizeof(b)) && b) {
-        std::uint32_t v = 0;
-        if (safe_read(b + 0x2e4, &v, sizeof(v)) && v) {
-            return true;
-        }
-    }
-    return false;
-}
