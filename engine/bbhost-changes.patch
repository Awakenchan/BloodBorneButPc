-    }
-    case ORBIS_NP_MATCHING2_ROOM_EVENT_KICKEDOUT: {
-        p.room_update = std::make_unique<OrbisNpMatching2RoomUpdate>();
-        OrbisNpMatching2RoomUpdate& u = *p.room_update;
-        u = OrbisNpMatching2RoomUpdate{};
-        u.eventCause = cause;
