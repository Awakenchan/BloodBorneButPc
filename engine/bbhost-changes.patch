+            const auto slept = std::chrono::steady_clock::now() - begin;
+            *remaining = duration > slept
+                             ? std::chrono::duration_cast<std::chrono::nanoseconds>(duration - slept)
+                             : std::chrono::nanoseconds(0);
+        }
