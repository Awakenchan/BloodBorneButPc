-bool Rasterizer::HasUnsubmittedSignals() {
-    if (local_signal_count.load(std::memory_order_acquire) != 0) {
-        return true; // for the current tick, held by the recording thread
-    }
-    std::scoped_lock lk{gpu_signals_mutex};
