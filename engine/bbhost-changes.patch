-            request_data = BuildGetWorldInfoListPayload(*ctx, reply);
-            ctx->request_payload_override = nullptr;
-            error_code = ORBIS_OK;
-        }
-
-        PendingEvent ev{};
-        ev.type = PendingEvent::REQUEST_CB;
-        ev.ctx_id = ctx_id;
-        ev.fire_at = std::chrono::steady_clock::now();
-        ev.req_id = req_id;
-        ev.req_event = req_event;
