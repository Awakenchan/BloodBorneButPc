+    PFN_ReleaseFeature release_feature = nullptr;
+    PFN_Shutdown1 shutdown = nullptr;
+
+    bool initialized = false;
+    NgxParameter* capabilities = nullptr;
+    NgxParameter* params = nullptr;
+    NgxHandle* feature = nullptr;
