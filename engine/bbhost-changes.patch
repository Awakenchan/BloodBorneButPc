+    auto& room = *p.room_data;
+    room = {};
+    room.publicSlots = static_cast<u16>(rd.public_slots());
+    room.privateSlots = static_cast<u16>(rd.private_slots());
+    room.openPublicSlots = static_cast<u16>(rd.open_public_slots());
