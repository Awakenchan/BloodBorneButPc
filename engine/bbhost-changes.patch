@@ -0,0 +1,174 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "elf.h"
+
+#include <algorithm>
+
+namespace start {
+
+const std::uint8_t* Span(const Bytes& data, std::uint64_t offset, std::uint64_t size) {
+    if (offset > data.size() || size > data.size() - offset)
+        throw Error("out of bounds: " + Hex(offset) + "+" + Hex(size) + " / " + Hex(data.size()));
+    return data.data() + offset;
+}
+
+namespace {
+constexpr std::uint64_t kLimit = 512ull << 20;
+
+struct Header {
+    std::uint64_t entry, phoff;
+    std::uint16_t phentsize, phnum;
+};
+
+Header ReadHeader(const Bytes& data, std::uint64_t at) {
+    const std::uint8_t* h = Span(data, at, 64);
+    if (std::memcmp(h, "\x7f" "ELF\x02\x01\x01", 7) || Load<std::uint16_t>(h + 18) != 62)
+        throw Error("expected little-endian x86-64 ELF");
+    Header header{Load<std::uint64_t>(h + 24), Load<std::uint64_t>(h + 32), Load<std::uint16_t>(h + 54),
+                  Load<std::uint16_t>(h + 56)};
+    if (header.phentsize != 56 || header.phnum == 0 || header.phnum >= 256)
+        throw Error("unsupported program headers");
+    return header;
+}
+
+Ph ReadPh(const Bytes& data, std::uint64_t at) {
+    const std::uint8_t* p = Span(data, at, 56);
+    return Ph{Load<std::uint32_t>(p), Load<std::uint32_t>(p + 4), Load<std::uint64_t>(p + 8),
+              Load<std::uint64_t>(p + 16), Load<std::uint64_t>(p + 24), Load<std::uint64_t>(p + 32),
+              Load<std::uint64_t>(p + 40), Load<std::uint64_t>(p + 48)};
+}
+
+bool Required(std::uint32_t type) {
+    return type == 1 || type == 2 || type == 0x61000000 || type == 0x61000010;
+}
+
+Executable ParseElf(const Bytes& data) {
+    const Header header = ReadHeader(data, 0);
+    Executable out;
+    out.entry = header.entry;
+    for (int i = 0; i < header.phnum; ++i) out.ph.push_back(ReadPh(data, header.phoff + std::uint64_t(i) * 56));
+    std::uint64_t end = 0;
+    for (const Ph& p : out.ph) end = std::max(end, p.offset + p.filesz);
+    if (end > kLimit) throw Error("probe image exceeds 512 MiB limit");
+    out.elf.assign(end, 0);
+    std::copy_n(data.begin(), std::min<std::uint64_t>(end, data.size()), out.elf.begin());
+    for (int i = 0; i < int(out.ph.size()); ++i) {
+        const Ph& p = out.ph[i];
+        if (p.filesz && p.offset + p.filesz > data.size()) {
+            out.missing.push_back(i);
+            if (Required(p.type)) throw Error("required segment " + std::to_string(i) + " is unavailable");
+        }
+    }
+    return out;
+}
+} // namespace
+
+Executable ParseSelf(const Bytes& data) {
+    if (std::memcmp(Span(data, 0, 4), "\x7f" "ELF", 4) == 0) return ParseElf(data);
+    if (std::memcmp(Span(data, 0, 4), "O\x15=\x1d", 4)) throw Error("expected a PS4 executable (SELF or ELF)");
+    const std::uint16_t count = Load<std::uint16_t>(Span(data, 24, 2));
+    const std::uint64_t base = 32 + std::uint64_t(count) * 32;
+    const Header header = ReadHeader(data, base);
+    Executable out;
+    out.entry = header.entry;
+    for (int i = 0; i < header.phnum; ++i)
+        out.ph.push_back(ReadPh(data, base + header.phoff + std::uint64_t(i) * 56));
+    std::uint64_t end = 0;
+    for (const Ph& p : out.ph) end = std::max(end, p.offset + p.filesz);
+    if (end > kLimit) throw Error("probe image exceeds 512 MiB limit");
+    out.elf.assign(end, 0);
+    const std::uint64_t header_end = header.phoff + std::uint64_t(header.phnum) * 56;
+    const std::uint8_t* head = Span(data, base, header_end);
+    if (header_end > out.elf.size()) out.elf.resize(header_end, 0);
+    std::copy_n(head, header_end, out.elf.begin());
+    std::vector<std::pair<std::uint64_t, std::uint64_t>> covered{{0, header_end}};
+    for (int i = 0; i < count; ++i) {
+        const std::uint8_t* s = Span(data, 32 + std::uint64_t(i) * 32, 32);
+        const std::uint64_t flags = Load<std::uint64_t>(s), off = Load<std::uint64_t>(s + 8),
+                            size = Load<std::uint64_t>(s + 16), mem = Load<std::uint64_t>(s + 24);
+        if (!(flags & 0x800)) continue;
+        if (flags & 10) throw Error("encrypted/compressed SELF segment is unsupported");
+        const std::uint64_t index = (flags >> 20) & 4095;
+        if (index >= out.ph.size()) throw Error("invalid segment index");
+        const Ph& p = out.ph[index];
+        if (size != p.filesz || size != mem) throw Error("unsupported blocked segment layout");
+        const std::uint8_t* src = Span(data, off, size);
+        if (p.offset + size > out.elf.size()) out.elf.resize(p.offset + size, 0);
+        std::copy_n(src, size, out.elf.begin() + std::ptrdiff_t(p.offset));
+        covered.emplace_back(p.offset, p.offset + size);
+    }
+    for (int i = 0; i < int(out.ph.size()); ++i) {
+        const Ph& p = out.ph[i];
+        if (!p.filesz) continue;
+        const bool present = std::any_of(covered.begin(), covered.end(), [&](const auto& range) {
+            return range.first <= p.offset && p.offset + p.filesz <= range.second;
+        });
+        if (!present) {
+            out.missing.push_back(i);
+            if (Required(p.type)) throw Error("required segment " + std::to_string(i) + " is unavailable");
+        }
+    }
+    return out;
+}
+
+std::map<std::string, SfoValue> ParseSfo(const Bytes& data) {
+    const std::uint8_t* h = Span(data, 0, 20);
+    if (std::memcmp(h, "\0PSF", 4)) throw Error("bad SFO signature");
+    const std::uint32_t keys = Load<std::uint32_t>(h + 8), values = Load<std::uint32_t>(h + 12),
+                        count = Load<std::uint32_t>(h + 16);
+    std::map<std::string, SfoValue> out;
+    for (std::uint32_t i = 0; i < count; ++i) {
+        const std::uint8_t* e = Span(data, 20 + std::uint64_t(i) * 16, 16);
+        const std::uint16_t key = Load<std::uint16_t>(e), format = Load<std::uint16_t>(e + 2);
+        const std::uint32_t size = Load<std::uint32_t>(e + 4), offset = Load<std::uint32_t>(e + 12);
+        const std::uint64_t name_at = std::uint64_t(keys) + key;
+        Span(data, name_at, 1);
+        const auto name_end = std::find(data.begin() + std::ptrdiff_t(name_at), data.end(), 0);
+        if (name_end == data.end()) throw Error("bad SFO key");
+        const std::string name(data.begin() + std::ptrdiff_t(name_at), name_end);
+        const std::uint8_t* v = Span(data, std::uint64_t(values) + offset, size);
+        if (format == 0x404) {
+            if (size < 4) throw Error("bad SFO integer");
+            out[name] = Load<std::uint32_t>(v);
+        } else {
+            std::string text(reinterpret_cast<const char*>(v), size);
+            while (!text.empty() && text.back() == '\0') text.pop_back();
+            out[name] = text;
+        }
+    }
+    return out;
+}
+
+std::string SfoText(const std::map<std::string, SfoValue>& sfo, const std::string& key, std::string_view fallback) {
+    const auto it = sfo.find(key);
+    if (it == sfo.end()) return std::string(fallback);
+    if (const auto* text = std::get_if<std::string>(&it->second)) return *text;
+    return std::to_string(std::get<std::uint32_t>(it->second));
+}
+
+std::vector<Ph> ProgramHeaders(const Bytes& elf) {
+    const std::uint64_t phoff = Load<std::uint64_t>(Span(elf, 0x20, 8));
+    const std::uint16_t entsize = Load<std::uint16_t>(Span(elf, 0x36, 2));
+    const std::uint16_t count = Load<std::uint16_t>(Span(elf, 0x38, 2));
+    std::vector<Ph> out;
+    for (int i = 0; i < count; ++i) out.push_back(ReadPh(elf, phoff + std::uint64_t(i) * entsize));
+    return out;
+}
+
+std::optional<Bytes> OriginalBytes(const Bytes& elf, std::uint64_t offset, std::size_t length) {
+    for (const Ph& p : ProgramHeaders(elf)) {
+        if (p.type == 1 && p.vaddr <= offset && offset + length <= p.vaddr + p.memsz) {
+            const std::uint64_t start = offset - p.vaddr;
+            Bytes data(length, 0);
+            if (start < p.filesz) {
+                const std::uint64_t n = std::min<std::uint64_t>(p.filesz - start, length);
+                const std::uint64_t from = p.offset + start;
+                const std::uint64_t avail = from < elf.size() ? std::min<std::uint64_t>(n, elf.size() - from) : 0;
+                std::copy_n(elf.begin() + std::ptrdiff_t(from), avail, data.begin());
+            }
+            return data;
+        }
+    }
+    return std::nullopt;
+}
+
+} // namespace start
diff --git a/start/elf.h b/start/elf.h
new file mode 100644
index 0000000..a08f13a
--- /dev/null
+++ b/start/elf.h
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// PS4 executables as the boot image needs them (was scripts/prepare.py parse_self/parse_elf/sfo):
+// an already plaintext SELF, or an eboot.bin some tools unwrap to a plain ELF.
+#pragma once
+#include "common.h"
+
+#include <map>
+#include <variant>
+
+namespace start {
+
+struct Ph {
+    std::uint32_t type, flags;
+    std::uint64_t offset, vaddr, paddr, filesz, memsz, align;
+};
+
+struct Executable {
+    Bytes elf;                 ///< the ELF with every present segment at its file offset
+    std::uint64_t entry = 0;
+    std::vector<Ph> ph;
+    std::vector<int> missing;  ///< program headers whose data the file lacks
+};
+
+Executable ParseSelf(const Bytes& data);
+
+/// param.sfo: integers (format 0x404) and text.
+using SfoValue = std::variant<std::uint32_t, std::string>;
+std::map<std::string, SfoValue> ParseSfo(const Bytes& data);
+std::string SfoText(const std::map<std::string, SfoValue>& sfo, const std::string& key, std::string_view fallback = "?");
+
+/// The loadable segments of an ELF file (program header table read from the file).
+std::vector<Ph> ProgramHeaders(const Bytes& elf);
+/// The executable's bytes at image offset `offset` (zero past a segment's file data), or none.
+std::optional<Bytes> OriginalBytes(const Bytes& elf, std::uint64_t offset, std::size_t length);
+
+/// Bounds-checked view.
+const std::uint8_t* Span(const Bytes& data, std::uint64_t offset, std::uint64_t size);
+
+} // namespace start
diff --git a/start/main.cpp b/start/main.cpp
new file mode 100644
index 0000000..3d4d767
--- /dev/null
+++ b/start/main.cpp
@@ -0,0 +1,524 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bb-start.exe: starts Bloodborne PC natively (was scripts/run_windows.py and the scripts it ran).
+//
+//     bb-start.exe [--game-dir DIR] [bb-probe options...]
+//
+// The game folder: --game-dir, else BB_GAME_DIR, else the last one used (out/game_dir.txt).
+// Then: the online profile, the GPU caches of another shader compiler cleared, mods, the boot
+// image (prepared again only when the game or this program changes), the engine's assets, the
+// patches, and bb-probe with the session log as its output. Its exit code is this program's.
+#include "assets.h"
+#include "common.h"
+#include "elf.h"
+#include "mods.h"
+#include "online.h"
+#include "patches.h"
+#include "prepare.h"
+
+#include <windows.h>
+
+#include <nlohmann/json.hpp>
+
+#include <chrono>
+
+
+namespace start {
+namespace {
+
+fs::path SelfPath() {
+    wchar_t buffer[32768];
+    const DWORD n = GetModuleFileNameW(nullptr, buffer, DWORD(std::size(buffer)));
+    return fs::path(std::wstring(buffer, n));
+}
+
+struct Folders {
+    fs::path engine;   // engine\ (out\, patches\, data\)
+    fs::path package;  // the package: package.json, bbport.ini, user, mods, logs
+    fs::path out;      // engine\out: the programs and what each start generates
+};
+
+Folders Locate() {
+    Folders f;
+    f.out = SelfPath().parent_path();
+    f.engine = f.out.parent_path();
+    std::error_code error;
+    f.package = Lower(Utf8(f.engine.filename())) == "engine" && fs::is_regular_file(f.engine.parent_path() / "package.json", error)
+                    ? f.engine.parent_path()
+                    : f.engine;
+    return f;
+}
+
+std::optional<std::string> SettingValue(const fs::path& config, const std::string& key) {
+    return Setting(ReadSettings(config), key);
+}
+
+// bbport: a new shader compiler: each cache folder (one per game, CUSA03173...) is recompiled by
+// bb-shader-lab from the shader states kept beside its shaders (--recompile-cache), so its
+// pipelines are built at the start instead of every shader compiling again in play. A folder it
+// cannot recompile is removed, as every folder was before 0.9.34 beta 6. BB_SHADER_STATES=0: removed.
+bool RecompileGpuCache(const fs::path& cache, const fs::path& recompiler) {
+    std::error_code error;
+    if (Env("BB_SHADER_STATES", "1") == "0" || !fs::is_regular_file(recompiler, error)) return false;
+    bool all = true;
+    for (const auto& entry : fs::directory_iterator(cache, error)) {
+        std::error_code e;
+        if (!entry.is_directory(e) || !fs::is_regular_file(entry.path() / "profile.bin", e)) continue;
+        std::string output;
+        const auto start = std::chrono::steady_clock::now();
+        const int code = RunProgram(recompiler, {L"--recompile-cache", entry.path().native()}, &output);
+        const double seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+        const auto line = output.rfind("Shader cache:");
+        if (code == 0 && line != std::string::npos) {
+            Log("GPU cache %s: %s (%.1f s)", Utf8(entry.path().filename()).c_str(),
+                Trim(output.substr(line + 14, output.find('\n', line) - line - 14)).c_str(), seconds);
+        } else {
+            fs::remove_all(entry.path(), e);
+            Log("GPU cache %s: not recompiled (exit %d); its shaders compile again in play",
+                Utf8(entry.path().filename()).c_str(), code);
+            all = false;
+        }
+    }
+    return all;
+}
+
+// bbport: the shader catalog shipped in engine\shader-catalog\<game> (specializations, pipeline keys
+// and draw states, no code): once per catalog, into a cache made on a GPU with the catalog's
+// profile (its first start makes it), the code taken from this PC's game files. Its shaders are
+// then compiled before the start instead of in play. BB_SHADER_CATALOG=0: not used.
+void SeedGpuCache(const fs::path& cache, const fs::path& catalogs, const fs::path& game, const fs::path& eboot,
+                  const fs::path& recompiler) {
+    std::error_code error;
+    if (Env("BB_SHADER_CATALOG", "1") == "0" || !fs::is_regular_file(recompiler, error)) return;
+    for (const auto& entry : fs::directory_iterator(catalogs, error)) {
+        std::error_code e;
+        const fs::path target = cache / entry.path().filename();
+        if (!entry.is_directory(e) || !fs::is_regular_file(target / "profile.bin", e)) continue;
+        // The catalog's identity: its files' count and size, as shipped.
+        std::uint64_t files = 0, bytes = 0;
+        for (const auto& file : fs::directory_iterator(entry.path(), e)) {
+            ++files;
+            bytes += file.file_size(e);
+        }
+        const fs::path marker = target / ("catalog-" + std::to_string(files) + "-" + std::to_string(bytes) + ".applied");
+        if (fs::exists(marker, e)) continue;
+        std::string output;
+        const auto start = std::chrono::steady_clock::now();
+        const int code = RunProgram(recompiler, {L"--seed-cache", entry.path().native(), target.native(),
+                                                 game.native(), eboot.native()}, &output);
+        const double seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+        const auto first = output.find("Shader catalog:");
+        const auto last = output.rfind("Shader cache:");
+        if (first != std::string::npos)
+            Log("GPU cache %s: %s", Utf8(entry.path().filename()).c_str(),
+                Trim(output.substr(first + 16, output.find('\n', first) - first - 16)).c_str());
+        if (code == 0 && last != std::string::npos)
+            Log("GPU cache %s: %s (%.1f s)", Utf8(entry.path().filename()).c_str(),
+                Trim(output.substr(last + 14, output.find('\n', last) - last - 14)).c_str(), seconds);
+        // Once per catalog, whatever came of it (another GPU's catalog stays unused).
+        WriteText(marker, std::to_string(code) + "\n");
+    }
+}
+
+void ResetStaleGpuCache(const fs::path& cache, const std::string& identity, const std::string& legacy,
+                        const fs::path& recompiler) {
+    const fs::path stamp = cache / "engine.txt";
+    std::error_code error;
+    try {
+        const std::string stamped = Trim(ReadText(stamp));
+        if (identity.empty() || stamped == identity) return;
+        // Made by an earlier engine from these same sources (its identity hashed whole files).
+        if (!legacy.empty() && stamped == legacy) {
+            WriteText(stamp, identity + "\n");
+            return;
+        }
+    } catch (const Error&) {
+    }
+    if (fs::is_directory(cache, error) && RecompileGpuCache(cache, recompiler)) {
+        WriteText(stamp, identity + "\n");
+        Log("GPU cache: the shader compiler changed (%s); recompiled before the start", identity.c_str());
+        return;
+    }
+    bool removed = false;
+    if (fs::is_directory(cache, error)) {
+        for (const auto& entry : fs::directory_iterator(cache, error)) {
+            if (entry.path() == stamp || Lower(Utf8(entry.path().extension())) == ".vkcache") continue;
+            std::error_code e;
+            if (entry.is_directory(e) && !entry.is_symlink(e)) fs::remove_all(entry.path(), e);
+            else fs::remove(entry.path(), e);
+            if (e) {
+                Log("GPU cache: cannot remove %s: %s", Utf8(entry.path().filename()).c_str(), e.message().c_str());
+                return;
+            }
+            removed = true;
+        }
+    }
+    fs::create_directories(cache, error);
+    WriteText(stamp, identity + "\n");
+    if (removed)
+        Log("GPU cache: cleared (%s: the shader compiler changed); shaders compile again on this start", identity.c_str());
+}
+
+std::string ConfigureFrameRate() {
+    std::string fps = Env("BB_FPS", "60");
+    if (fps == "120" || fps == "144") {
+        SetEnv("BB_FPS", fps);
+        SetEnv("BB_FPS_LIMIT", fps);
+        SetEnv("BB_VBLANK_HZ", fps);
+        return fps;
+    }
+    const bool digits = !fps.empty() && fps.find_first_not_of("0123456789") == std::string::npos && fps.size() < 6;
+    if (fps == "uncap" || (digits && std::stoi(fps) > 90)) {
+        // bbport: Uncapped stops at 240 FPS unless BB_FPS_LIMIT says otherwise (0: none). With no
+        // limit on a 480 Hz screen the Uncap FPS++ patch froze Ludwig's second phase (its boss
+        // intros are known to freeze at extreme frame rates); past 240 nothing is gained.
+        std::string limit = digits ? fps : Env("BB_FPS_LIMIT", "240");
+        if (limit.empty() || limit.find_first_not_of("0123456789") != std::string::npos) limit = "0";
+        SetEnv("BB_FPS", "uncap");
+        SetEnv("BB_FPS_LIMIT", limit);
+        SetEnv("BB_VBLANK_HZ", "0");
+        return "uncap";
+    }
+    if (fps != "30" && fps != "60" && fps != "90") {
+        Log("Unsupported Windows FPS preset '%s'; using 60 FPS.", fps.c_str());
+        fps = "60";
+    }
+    SetEnv("BB_FPS", fps);
+    SetEnv("BB_FPS_LIMIT", fps);
+    SetEnv("BB_VBLANK_HZ", fps == "90" ? "90" : "60");
+    return fps;
+}
+
+std::optional<Size> DisplaySize() {
+    SetProcessDPIAware();
+    const int w = GetSystemMetrics(SM_CXSCREEN), h = GetSystemMetrics(SM_CYSCREEN);
+    if (w < 640 || h < 360) return std::nullopt;
+    return Size{w - w % 2, h - h % 2};
+}
+
+int RunProbe(const fs::path& probe, const std::vector<std::wstring>& arguments, const fs::path& cwd) {
+    HANDLE log = static_cast<HANDLE>(LogHandle());
+    // The session log when the launcher names one, else this program's own output (the launcher
+    // reads it from a pipe): bb-probe writes where this program does.
+    STARTUPINFOW startup{sizeof startup};
+    startup.dwFlags = STARTF_USESTDHANDLES;
+    startup.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
+    startup.hStdOutput = log ? log : GetStdHandle(STD_OUTPUT_HANDLE);
+    startup.hStdError = log ? log : GetStdHandle(STD_ERROR_HANDLE);
+    std::fflush(stdout);
+    std::wstring line = CommandLine(probe, arguments);
+    std::string shown;
+    for (const auto& a : arguments) shown += " '" + Utf8(a) + "'";
+    Log("Starting: '%s'%s", Utf8(probe).c_str(), shown.c_str());
+    PROCESS_INFORMATION process{};
+    if (!CreateProcessW(probe.c_str(), line.data(), nullptr, nullptr, TRUE, 0, nullptr, cwd.c_str(), &startup, &process))
+        throw Error("cannot start " + Utf8(probe));
+    WaitForSingleObject(process.hProcess, INFINITE);
+    DWORD code = 0;
+    GetExitCodeProcess(process.hProcess, &code);
+    CloseHandle(process.hProcess);
+    CloseHandle(process.hThread);
+    Log("bb-probe exited with code %u", unsigned(code));
+    return int(code);
+}
+
+int Main(std::vector<std::wstring> arguments) {
+    const Folders folders = Locate();
+    std::optional<std::string> game = Env("BB_GAME_DIR");
+    if (arguments.size() > 1 && arguments[0] == L"--game-dir") {
+        game = Utf8(arguments[1]);
+        arguments.erase(arguments.begin(), arguments.begin() + 2);
+    }
+    const fs::path data = Path(Env("BB_DATA_DIR", Utf8(folders.package)));
+    const fs::path& out = folders.out;
+    // bb-probe takes its shader cache's folder from this at its start, before it reads its
+    // arguments; without it the folder was %APPDATA%\shadPS4 (bb-probe runs in engine\,
+    // which has no user folder): shared with the shadPS4 emulator, never reset with an
+    // engine update nor by the launcher's Clear, so a damaged or outdated shader stayed.
+    if (Env("BB_GPU_USER_DIR", "").empty()) SetEnv("BB_GPU_USER_DIR", Utf8(folders.package / "user"));
+    {
+        std::error_code error;
+        fs::create_directories(Path(Env("BB_GPU_USER_DIR", "")), error); // bb-probe falls back without it
+    }
+    try {
+        const auto package = nlohmann::json::parse(ReadText(folders.package / "package.json"));
+        const std::string engine = package.value("engine", "");
+        std::string identity = engine, legacy;
+        try {
+            const std::string id = Trim(ReadText(out / "gpu-cache.id"));
+            if (!id.empty()) identity = "gpu " + id;
+            const std::string old = Trim(ReadText(out / "gpu-cache.legacy.id"));
+            if (!old.empty()) legacy = "gpu " + old;
+        } catch (const Error&) {
+        }
+        ResetStaleGpuCache(Path(Env("BB_GPU_USER_DIR", "")) / "cache", identity, legacy, out / "bb-shader-lab.exe");
+    } catch (const std::exception&) {
+    }
+    fs::create_directories(out);
+    if (!Env("BB_CONFIG")) SetEnv("BB_CONFIG", Utf8(data / "bbport.ini"));
+    const fs::path config = Path(*Env("BB_CONFIG"));
+    const auto settings = ReadSettings(config);
+    try {
+        Log(ConfigureOnline(settings, data) ? "Online: configured server profile and automatic game redirect"
+                                            : "Online: offline mode");
+    } catch (const Error& error) {
+        Log("Online configuration: %s", error.what());
+        return 1;
+    }
+    std::error_code error;
+    if (!Env("BB_FSR411_DIR") && !fs::is_directory(folders.engine / "fsr4_411", error) && fs::is_directory(data / "fsr4_411", error))
+        SetEnv("BB_FSR411_DIR", Utf8(data / "fsr4_411"));
+    if (!Env("BB_FSR4VK_DIR") && fs::is_regular_file(folders.engine / "fsr4vk" / "amd_fidelityfx_upscaler_vk.dll", error))
+        SetEnv("BB_FSR4VK_DIR", Utf8(folders.engine / "fsr4vk"));
+    const fs::path remembered = out / "game_dir.txt";
+    if ((!game || game->empty()) && fs::is_regular_file(remembered, error)) game = Trim(ReadText(remembered));
+    const fs::path game_dir = game && !game->empty() ? Path(*game) : folders.package.parent_path() / "CUSA03173";
+    if (!fs::is_regular_file(game_dir / "eboot.bin", error)) {
+        Log("No eboot.bin in %s (pass --game-dir or set BB_GAME_DIR).", Utf8(game_dir).c_str());
+        return 1;
+    }
+    const fs::path original = fs::canonical(game_dir);
+    WriteText(remembered, Utf8(original));
+    SetEnv("BB_GAME_DIR", Utf8(original));
+    // The in-game menu's "Apply and restart" runs this program again (probe.c runtime_restart).
+    {
+        std::vector<std::wstring> all(arguments);
+        all.insert(all.begin(), {L"--game-dir", original.native()});
+        SetEnv("BB_RESTART_COMMAND", Utf8(CommandLine(SelfPath(), all)));
+    }
+
+    fs::path merged;
+    try {
+        merged = BuildModsOverlay(original, out, Path(Env("BB_MODS_DIR", Utf8(data / "mods"))),
+                                  Path(Env("BB_MODS_CONFIG", Utf8(data / "mods.json"))), Env("BB_MODS_ENABLED", "1") == "1");
+    } catch (const std::exception& e) {
+        Log("Mods: %s", e.what());
+        return 1;
+    }
+    std::optional<fs::path> overlay;
+    if (fs::canonical(merged) != original) overlay = merged;
+    struct Cleanup {
+        std::optional<fs::path>& overlay;
+        ~Cleanup() {
+            if (overlay) try {
+                    RemoveOverlay(*overlay);
+                } catch (...) {
+                }
+        }
+    } cleanup{overlay};
+    const char* const core[] = {"dvdroot_ps4/shader/gxshader.shaderbnd.dcx", "dvdroot_ps4/other/systex.tpf.dcx"};
+    std::string missing;
+    for (const char* name : core)
+        if (!fs::is_regular_file(merged / Path(name), error)) missing += (missing.empty() ? "" : ", ") + std::string(name);
+    if (!missing.empty() && overlay &&
+        std::all_of(std::begin(core), std::end(core), [&](const char* n) { return fs::is_regular_file(original / Path(n), error); })) {
+        Log("Mods: the merged game lost its own files; starting without mods");
+        RemoveOverlay(*overlay);
+        overlay.reset();
+        merged = original;
+        missing.clear();
+    }
+    if (!missing.empty()) {
+        Log("The game folder %s is incomplete: %s missing. Dump or extract the game again (base game plus the 1.09 update).",
+            Utf8(original).c_str(), missing.c_str());
+        return 1;
+    }
+    // The game as the engine sees it, mods over it: the PC menus are built from these files.
+    SetEnv("BB_GAME_MERGED", Utf8(merged));
+
+    try {
+        PrepareImage(merged, out, folders.engine);
+    } catch (const GameCheckError& e) {
+        Log("\nUnsupported game files: %s\nSet BB_SKIP_GAME_CHECK=1 to start anyway.", e.what());
+        return 2;
+    } catch (const std::exception& e) {
+        Log("prepare failed: %s", e.what());
+        return 1;
+    }
+    for (const char* key : {"BB_DREAM_MIRROR_ASSET", "BB_ENGINE_IMAGE_SHA256", "BB_PC_MENU_ASSETS", "BB_REBIRTH_ASSET"})
+        UnsetEnv(key);
+    // Another executable than the 1.09 code (prepare.cpp CheckGame: the verified image or a patched
+    // one; CUSA00900 1.09 is that same code): the patches write fixed addresses of that code, so
+    // none are applied (CompilePatches); hooks check the code they replace and leave themselves out.
+    bool other_edition = false;
+    try {
+        (void)VerifyExecutable(out / "eboot.elf");
+    } catch (const std::exception&) {
+        std::string code;
+        try {
+            code = Trim(ReadText(out / "game-code.txt"));
+        } catch (const std::exception&) {
+        }
+        std::string title;
+        try {
+            title = SfoText(ParseSfo(ReadFile(merged / "sce_sys" / "param.sfo")), "TITLE_ID");
+        } catch (const std::exception&) {
+        }
+        // BB_SKIP_GAME_CHECK=1 left the code unchecked: the title decides, as before.
+        other_edition = code == "unchecked" ? title != "CUSA03173" : code != "1.09";
+    }
+    if (other_edition) SetEnv("BB_OTHER_EDITION", "1");
+    else UnsetEnv("BB_OTHER_EDITION");
+    const auto is_on = [&](const char* key) { return Setting(settings, key) == "1"; };
+    try {
+        SetEnv("BB_ENGINE_IMAGE_SHA256", VerifyExecutable(out / "eboot.elf"));
+        if (is_on("change_appearance")) {
+            const fs::path asset = PrepareMirror(merged, out / "eboot.elf", data / "engine-assets");
+            SetEnv("BB_DREAM_MIRROR_ASSET", Utf8(asset));
+            Log("Engine: Dream mirror prepared locally: %s", Utf8(asset).c_str());
+        }
+        if (is_on("change_appearance") || is_on("camera_controls") || is_on("rebirth") || is_on("graphics_controls") ||
+            Setting(settings, "pc_controls") != "0" || Setting(settings, "widescreen") != "0") {
+            try {
+                const fs::path menus = PrepareMenuAssets(merged, out / "eboot.elf", data / "engine-assets",
+                                                         out / "bb-engine-assets.exe", is_on("rebirth"));
+                SetEnv("BB_PC_MENU_ASSETS", Utf8(menus));
+                Log("Engine: native PC menus prepared locally: %s", Utf8(menus).c_str());
+                if (is_on("rebirth"))
+                    SetEnv("BB_REBIRTH_ASSET", Utf8(menus / Path("dvdroot_ps4/script/talk/m24_02_00_00.talkesdbnd.dcx")));
+            } catch (const std::exception& e) {
+                Log("Engine: native PC menus disabled: %s", e.what());
+            }
+        }
+    } catch (const std::exception& e) {
+        Log("Engine: enhancement preparation skipped: %s", e.what());
+    }
+    if (!Env("BB_DISPLAY_SIZE") || Env("BB_DISPLAY_SIZE", "").empty()) {
+        if (const auto size = DisplaySize()) {
+            SetEnv("BB_DISPLAY_SIZE", std::to_string(size->w) + "x" + std::to_string(size->h));
+            if (Lower(Setting(settings, "output_res").value_or("")) == "auto")
+                Log("Output resolution: the display's own, %dx%d", size->w, size->h);
+        }
+    }
+    if (Env("BB_AUTO_RENDER_RES", "") == "1")
+        for (const char* key : {"BB_RENDER_RES", "BB_OUTPUT_RES", "BB_AUTO_RENDER_RES"}) UnsetEnv(key);
+    const std::string fps = ConfigureFrameRate();
+    std::optional<std::pair<Size, Size>> scaled;
+    if (Env("BB_RENDER_RES", "").empty() && !other_edition) {
+        try {
+            scaled = ScaledSizes(ReadSettings(config));
+        } catch (const Error&) {
+        }
+    }
+    std::string live = "0";
+    if (scaled) {
+        live = Env("BB_LIVE_RES", "");
+        if (live.empty()) live = SettingValue(config, "live_resolution").value_or("0");
+        if (live.empty()) live = "0";
+        if (live == "auto") {
+            std::string answer;
+            try {
+                RunProgram(out / "bb-gpu-capabilities.exe", {L"--live-resolution"}, &answer);
+            } catch (const Error&) {
+            }
+            live = Trim(answer).empty() ? "0" : Trim(answer);
+        }
+        live = live == "1" ? "1" : "0";
+    }
+    const auto size_text = [](Size s) { return std::to_string(s.w) + "x" + std::to_string(s.h); };
+    if (live == "1") {
+        Log("Output %s: live resolution changes (live_resolution=0: startup patch)", size_text(scaled->second).c_str());
+    } else if (scaled) {
+        SetEnv("BB_RENDER_RES", size_text(scaled->first));
+        SetEnv("BB_OUTPUT_RES", size_text(scaled->second));
+        SetEnv("BB_AUTO_RENDER_RES", "1");
+        if (std::int64_t(scaled->first.w) * scaled->first.h > 1920ll * 1080 && !Env("BB_DMEM_MB")) {
+            if (const unsigned long error = PoolRefused(9152))
+                Log("Memory: Windows refused the 9152 MiB pool a scene above 1080p uses (error %lu); 5056 MiB, "
+                    "some models may not show at this resolution", error);
+            else
+                SetEnv("BB_DMEM_MB", "9152");
+        }
+        Log("Output %s: scene %s, direct memory %s MiB (live_resolution=1: live changes)", size_text(scaled->second).c_str(),
+            size_text(scaled->first).c_str(), Env("BB_DMEM_MB", "5056").c_str());
+    }
+    PatchResult patches;
+    try {
+        patches = CompilePatches(PatchRequest{
+            .out = out,
+            .xml = folders.engine / "patches" / "Bloodborne.xml",
+            .settings = config,
+            .game = merged,
+            .patches_dir = Path(Env("BB_PATCHES_DIR", Utf8(data / "patches"))),
+            .patches_config = Path(Env("BB_PATCHES_CONFIG", Utf8(data / "patches.json"))),
+            .fps = fps,
+            .extra = Env("BB_PATCHES", ""),
+            .render_res = Env("BB_RENDER_RES", ""),
+            .output_res = Env("BB_OUTPUT_RES", ""),
+        });
+    } catch (const std::exception& e) {
+        Log("Patches: %s", e.what());
+        return 1;
+    }
+    if (!(patches.ui == Size{1920, 1080})) {
+        SetEnv("BB_UI_SIZE", size_text(patches.ui));
+        Log("Widescreen: UI viewport %s (the 16:9 stage centred in it)", size_text(patches.ui).c_str());
+    } else {
+        UnsetEnv("BB_UI_SIZE");
+    }
+    if (patches.heap_patch && !Env("BB_DMEM_MB")) {
+        SetEnv("BB_DMEM_MB", "9152");
+        Log("Patches: the game's heaps are enlarged; direct memory 9152 MiB");
+    }
+    if (const auto dmem = Env("BB_DMEM_MB"); dmem && *dmem == "9152") {
+        // Made now if no check made it yet; on a refusal the engine tries again on its own.
+        if (const unsigned long error = PoolRefused(9152))
+            Log("Memory: Windows refused the 9152 MiB pool before the start (error %lu)", error);
+        PoolHandOff(9152);
+    } else {
+        PoolHandOff(0);
+    }
+    try {
+        SeedGpuCache(Path(Env("BB_GPU_USER_DIR", "")) / "cache", folders.engine / "shader-catalog", merged,
+                     out / "eboot.elf", out / "bb-shader-lab.exe");
+    } catch (const std::exception&) {
+    }
+    const fs::path probe = out / "bb-probe.exe";
+    std::vector<std::wstring> command{(out / "boot-linked.bin").native(), L"--content-profile", (out / "content.bin").native(),
+                                      L"--patches", (out / "patches.bin").native(), L"--app0", merged.native(), L"--user",
+                                      Path(Env("BB_USER_DIR", Utf8(data / "user"))).native(), L"--timeout",
+                                      Wide(Env("BB_TIMEOUT", "0"))};
+    command.insert(command.end(), arguments.begin(), arguments.end());
+    return RunProbe(probe, command, folders.engine);
+}
+
+} // namespace
+} // namespace start
+
+int wmain(int argc, wchar_t** argv) {
+    start::InitLog();
+    std::vector<std::wstring> arguments(argv + 1, argv + argc);
+    try {
+        // Tests (engine/tests/test_start.py): one stage into a chosen folder, against the scripts'.
+        //   --test-prepare GAME OUT ENGINE
+        //   --test-patches OUT ENGINE SETTINGS GAME FPS RENDER_RES OUTPUT_RES PATCHES_DIR PATCHES_CONFIG
+        if (arguments.size() == 4 && arguments[0] == L"--test-prepare") {
+            start::PrepareImage(arguments[1], arguments[2], arguments[3]);
+            return 0;
+        }
+        if (arguments.size() == 5 && arguments[0] == L"--test-mods") {
+            const fs::path overlay = start::BuildModsOverlay(arguments[1], arguments[2], arguments[3], arguments[4], true);
+            std::printf("%s\n", start::Utf8(overlay).c_str());
+            return 0;
+        }
+        if (arguments.size() == 10 && arguments[0] == L"--test-patches") {
+            const auto result = start::CompilePatches(start::PatchRequest{
+                .out = arguments[1],
+                .xml = fs::path(arguments[2]) / "patches" / "Bloodborne.xml",
+                .settings = arguments[3],
+                .game = arguments[4],
+                .patches_dir = arguments[8],
+                .patches_config = arguments[9],
+                .fps = start::Utf8(arguments[5]),
+                .extra = start::Env("BB_PATCHES", ""),
+                .render_res = start::Utf8(arguments[6]),
+                .output_res = start::Utf8(arguments[7]),
+            });
+            start::Log("heap_patch=%d ui=%dx%d", int(result.heap_patch), result.ui.w, result.ui.h);
+            return 0;
+        }
+        return start::Main(std::move(arguments));
+    } catch (const std::exception& e) {
+        start::Log("bb-start: %s", e.what());
+        return 1;
+    }
+}
diff --git a/start/mods.cpp b/start/mods.cpp
new file mode 100644
index 0000000..d5c868c
--- /dev/null
+++ b/start/mods.cpp
@@ -0,0 +1,399 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "mods.h"
+#include "elf.h"
+
+#include <windows.h>
+#include <winioctl.h>
+
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <random>
+#include <set>
+
+namespace start {
+namespace {
+
+const std::set<std::wstring> kGameFolders{L"action", L"chr", L"event", L"facegen", L"font", L"map", L"menu",
+                                          L"movie", L"msg", L"mtd", L"obj", L"other", L"param", L"paramdef",
+                                          L"parts", L"remo", L"script", L"sfx", L"shader", L"sound"};
+const wchar_t* const kSerials[] = {L"CUSA00207", L"CUSA00208", L"CUSA00299", L"CUSA00900", L"CUSA01363",
+                                   L"CUSA03014", L"CUSA03023", L"CUSA03173", L"CUSA03179"};
+
+std::wstring Fold(std::wstring text) {
+    if (!text.empty()) CharLowerBuffW(text.data(), DWORD(text.size()));
+    return text;
+}
+
+bool IsDir(const fs::path& p) {
+    std::error_code e;
+    return fs::is_directory(p, e);
+}
+bool IsFile(const fs::path& p) {
+    std::error_code e;
+    return fs::is_regular_file(p, e);
+}
+bool Exists(const fs::path& p) {
+    return GetFileAttributesW(p.c_str()) != INVALID_FILE_ATTRIBUTES;
+}
+
+/// A junction or symbolic link (any reparse point): never followed, never written through.
+bool IsLink(const fs::path& p) {
+    const DWORD a = GetFileAttributesW(p.c_str());
+    return a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_REPARSE_POINT);
+}
+
+std::vector<fs::path> Entries(const fs::path& folder) {
+    std::vector<fs::path> out;
+    std::error_code e;
+    if (!IsDir(folder)) return out;
+    for (const auto& entry : fs::directory_iterator(folder, e)) out.push_back(entry.path());
+    return out;
+}
+
+/// `name` inside `folder`, matching an existing entry case-insensitively.
+fs::path Child(const fs::path& folder, const std::wstring& name) {
+    const std::wstring want = Fold(name);
+    for (const fs::path& entry : Entries(folder))
+        if (Fold(entry.filename().native()) == want) return entry;
+    return folder / name;
+}
+
+std::optional<std::pair<fs::path, fs::path>> ContentRoot(const fs::path& folder) {
+    if (!IsDir(folder)) return std::nullopt;
+    std::vector<std::wstring> wrappers{L"", L"app0"};
+    for (const wchar_t* s : kSerials) wrappers.push_back(s);
+    for (const std::wstring& wrapper : wrappers) {
+        const fs::path base = wrapper.empty() ? folder : Child(folder, wrapper);
+        if (IsDir(Child(base, L"dvdroot_ps4"))) return std::pair{base, fs::path()};
+    }
+    std::vector<fs::path> entries, folders;
+    for (const fs::path& e : Entries(folder))
+        if (!StartsWith(Utf8(e.filename()), ".")) entries.push_back(e);
+    for (const fs::path& e : entries)
+        if (IsDir(e)) folders.push_back(e);
+    if (!folders.empty() && std::all_of(folders.begin(), folders.end(), [](const fs::path& f) {
+            return kGameFolders.count(Fold(f.filename().native()));
+        }))
+        return std::pair{folder, fs::path(L"dvdroot_ps4")};
+    if (folders.size() == 1 && std::none_of(entries.begin(), entries.end(), [](const fs::path& e) {
+            if (!IsFile(e)) return false;
+            const std::wstring ext = Fold(e.extension().native());
+            return ext != L".txt" && ext != L".md" && ext != L".jpg" && ext != L".png" && ext != L".ini";
+        }))
+        return ContentRoot(folders[0]);
+    return std::nullopt;
+}
+
+std::vector<std::wstring> Discover(const fs::path& root) {
+    std::vector<std::wstring> names;
+    for (const fs::path& p : Entries(root))
+        if (IsDir(p) && ContentRoot(p)) names.push_back(p.filename().native());
+    std::sort(names.begin(), names.end(), [](const std::wstring& a, const std::wstring& b) {
+        const std::wstring fa = Fold(a), fb = Fold(b);
+        return fa != fb ? fa < fb : a < b;
+    });
+    return names;
+}
+
+std::vector<std::wstring> Selected(const fs::path& root, const fs::path& config) {
+    const std::vector<std::wstring> available = Discover(root);
+    if (config.empty() || !IsFile(config)) return available;
+    const auto settings = nlohmann::json::parse(ReadText(config));
+    std::set<std::wstring> disabled;
+    std::vector<std::wstring> order;
+    if (settings.contains("disabled")) {
+        if (!settings["disabled"].is_array()) throw Error("Disabled mods must be a list of folder names");
+        for (const auto& n : settings["disabled"]) {
+            if (!n.is_string()) throw Error("Disabled mods must be a list of folder names");
+            disabled.insert(Wide(n.get<std::string>()));
+        }
+    }
+    if (settings.contains("order")) {
+        if (!settings["order"].is_array()) throw Error("Mod order must be a list of folder names");
+        for (const auto& n : settings["order"]) {
+            if (!n.is_string()) throw Error("Mod order must be a list of folder names");
+            order.push_back(Wide(n.get<std::string>()));
+        }
+    }
+    std::vector<std::wstring> out;
+    order.insert(order.end(), available.begin(), available.end());
+    for (const std::wstring& n : order)
+        if (std::find(available.begin(), available.end(), n) != available.end() && !disabled.count(n) &&
+            std::find(out.begin(), out.end(), n) == out.end())
+            out.push_back(n);
+    return out;
+}
+
+void Walk(const fs::path& directory, const fs::path& root, std::vector<std::pair<fs::path, fs::path>>& files,
+          bool skip_links) {
+    std::vector<fs::path> folders, names;
+    for (const fs::path& entry : Entries(directory)) {
+        if (IsDir(entry)) {
+            if (IsLink(entry)) {
+                if (skip_links) Log("Mods: skipped the link %s (links are not followed)", Utf8(entry).c_str());
+                continue;
+            }
+            folders.push_back(entry);
+        } else {
+            names.push_back(entry);
+        }
+    }
+    std::sort(names.begin(), names.end());
+    for (const fs::path& source : names) {
+        if (IsLink(source)) {
+            if (skip_links) Log("Mods: skipped the link %s (links are not followed)", Utf8(source).c_str());
+            continue;
+        }
+        files.emplace_back(source.lexically_relative(root), source);
+    }
+    for (const fs::path& folder : folders) Walk(folder, root, files, skip_links);
+}
+
+std::vector<std::pair<fs::path, fs::path>> ModFiles(const fs::path& folder) {
+    const auto layout = ContentRoot(folder);
+    if (!layout) throw Error(Utf8(folder) + ": expected dvdroot_ps4 (or chr/, parts/, ...) inside the mod folder");
+    const fs::path root = fs::canonical(layout->first);
+    std::vector<std::pair<fs::path, fs::path>> found, out;
+    Walk(root, root, found, true);
+    for (auto& [relative, source] : found) {
+        const fs::path game_path = layout->second.empty() ? relative : layout->second / relative;
+        const std::wstring first = Fold(game_path.begin()->native());
+        if (first != L"dvdroot_ps4") {
+            if (first == L"eboot.bin" || first == L"sce_module" || first == L"sce_sys")
+                throw Error("Executable/system replacement is unsupported: " + Utf8(source));
+            continue;
+        }
+        if (!IsFile(source)) throw Error("Not a regular mod file: " + Utf8(source));
+        out.emplace_back(game_path, source);
+    }
+    return out;
+}
+
+std::optional<std::string> AppVersion(const fs::path& folder) {
+    try {
+        return SfoText(ParseSfo(ReadFile(folder / "sce_sys" / "param.sfo")), "APP_VER", "");
+    } catch (const std::exception&) {
+        return std::nullopt;
+    }
+}
+
+std::optional<fs::path> UpdateFolder(const fs::path& game) {
+    const std::wstring update = Fold(game.filename().native() + L"-update"),
+                       patch = Fold(game.filename().native() + L"-patch");
+    for (const fs::path& entry : Entries(game.parent_path())) {
+        const std::wstring name = Fold(entry.filename().native());
+        if (!IsDir(entry) || (name != update && name != patch) || !IsFile(Child(entry, L"eboot.bin"))) continue;
+        const auto version = AppVersion(entry);
+        if (version && !version->empty() && AppVersion(game) == version) {
+            Log("Game update: %s is already in the game (%s)", Utf8(entry.filename()).c_str(), version->c_str());
+            return std::nullopt;
+        }
+        return entry;
+    }
+    return std::nullopt;
+}
+
+void CreateJunction(const fs::path& target, const fs::path& link) {
+    if (!CreateDirectoryW(link.c_str(), nullptr)) throw Error("cannot create " + Utf8(link));
+    const std::wstring substitute = L"\\??\\" + fs::absolute(target).native();
+    const std::wstring print = fs::absolute(target).native();
+    const std::size_t path_bytes = (substitute.size() + 1 + print.size() + 1) * sizeof(wchar_t);
+    std::vector<std::uint8_t> buffer(8 + 8 + path_bytes, 0);
+    Store<std::uint32_t>(buffer.data(), IO_REPARSE_TAG_MOUNT_POINT);
+    Store<std::uint16_t>(buffer.data() + 4, std::uint16_t(8 + path_bytes));
+    Store<std::uint16_t>(buffer.data() + 8, 0);                                                   // substitute offset
+    Store<std::uint16_t>(buffer.data() + 10, std::uint16_t(substitute.size() * sizeof(wchar_t)));  // length
+    Store<std::uint16_t>(buffer.data() + 12, std::uint16_t((substitute.size() + 1) * sizeof(wchar_t)));
+    Store<std::uint16_t>(buffer.data() + 14, std::uint16_t(print.size() * sizeof(wchar_t)));
+    std::memcpy(buffer.data() + 16, substitute.c_str(), substitute.size() * sizeof(wchar_t));
+    std::memcpy(buffer.data() + 16 + (substitute.size() + 1) * sizeof(wchar_t), print.c_str(), print.size() * sizeof(wchar_t));
+    HANDLE handle = CreateFileW(link.c_str(), GENERIC_WRITE, 0, nullptr, OPEN_EXISTING,
+                                FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+    DWORD returned = 0;
+    const bool ok = handle != INVALID_HANDLE_VALUE &&
+                    DeviceIoControl(handle, FSCTL_SET_REPARSE_POINT, buffer.data(), DWORD(buffer.size()), nullptr, 0,
+                                    &returned, nullptr);
+    if (handle != INVALID_HANDLE_VALUE) CloseHandle(handle);
+    if (!ok) {
+        RemoveDirectoryW(link.c_str());
+        throw Error("cannot link " + Utf8(link) + " to " + Utf8(target));
+    }
+}
+
+/// `path` refers to `target` without copying the game: a junction, a hard link, else a copy.
+void Link(const fs::path& path, const fs::path& target) {
+    if (IsDir(target)) {
+        CreateJunction(target, path);
+    } else if (!CreateHardLinkW(path.c_str(), target.c_str(), nullptr)) {
+        if (!CopyFileW(target.c_str(), path.c_str(), TRUE)) throw Error("cannot link " + Utf8(path));
+    }
+}
+
+/// Removes a link made by Link (never what it refers to).
+void Unlink(const fs::path& path) {
+    const DWORD a = GetFileAttributesW(path.c_str());
+    if (a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_DIRECTORY) && (a & FILE_ATTRIBUTE_REPARSE_POINT)) {
+        if (!RemoveDirectoryW(path.c_str())) throw Error("cannot remove " + Utf8(path));
+        return;
+    }
+    if (!DeleteFileW(path.c_str())) {
+        SetFileAttributesW(path.c_str(), FILE_ATTRIBUTE_NORMAL);  // a read-only copy
+        if (!DeleteFileW(path.c_str())) throw Error("cannot remove " + Utf8(path));
+    }
+}
+
+fs::path Resolved(const fs::path& path) {
+    HANDLE handle = CreateFileW(path.c_str(), 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr,
+                                OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, nullptr);
+    if (handle == INVALID_HANDLE_VALUE) throw Error("cannot resolve " + Utf8(path));
+    wchar_t buffer[32768];
+    const DWORD n = GetFinalPathNameByHandleW(handle, buffer, DWORD(std::size(buffer)), FILE_NAME_NORMALIZED);
+    CloseHandle(handle);
+    std::wstring text(buffer, n);
+    if (text.rfind(L"\\\\?\\UNC\\", 0) == 0) text = L"\\\\" + text.substr(8);
+    else if (text.rfind(L"\\\\?\\", 0) == 0) text = text.substr(4);
+    return fs::path(text);
+}
+
+/// Materializes one directory level; never writes through a directory link.
+void Expand(const fs::path& directory) {
+    if (IsLink(directory)) {
+        const fs::path target = Resolved(directory);
+        if (!IsDir(target)) throw Error("File/directory conflict at " + Utf8(directory.filename()));
+        Unlink(directory);
+        fs::create_directory(directory);
+        for (const fs::path& entry : Entries(target)) Link(directory / entry.filename(), entry);
+    } else if (Exists(directory) && !IsDir(directory)) {
+        throw Error("File/directory conflict at " + Utf8(directory.filename()));
+    } else {
+        std::error_code e;
+        fs::create_directory(directory, e);
+    }
+}
+
+fs::path OverlayBase(const fs::path& game, const fs::path& out) {
+    const std::wstring out_drive = Fold(fs::absolute(out).root_name().native());
+    const std::wstring game_drive = Fold(game.root_name().native());
+    if (out_drive != game_drive) return game.parent_path() / L".bbport-overlays";
+    return out;
+}
+
+void RemoveStaleOverlays(const fs::path& out) {
+    for (const fs::path& entry : Entries(out)) {
+        if (!StartsWith(Utf8(entry.filename()), "mod-game-") || !IsDir(entry) || IsLink(entry)) continue;
+        try {
+            RemoveOverlay(entry);
+        } catch (const Error&) {
+        }
+    }
+}
+
+fs::path MakeTemporary(const fs::path& out) {
+    std::random_device random;
+    static const char letters[] = "abcdefghijklmnopqrstuvwxyz0123456789_";
+    for (int attempt = 0; attempt < 100; ++attempt) {
+        std::string name = "mod-game-";
+        for (int i = 0; i < 8; ++i) name += letters[random() % (sizeof letters - 1)];
+        const fs::path path = out / Path(name);
+        if (CreateDirectoryW(path.c_str(), nullptr)) return path;
+    }
+    throw Error("cannot create a mod overlay in " + Utf8(out));
+}
+
+fs::path BuildOverlay(fs::path game, const fs::path& out_base, const std::vector<std::pair<std::wstring, fs::path>>& mods,
+                      const std::optional<fs::path>& update) {
+    game = fs::canonical(game);
+    fs::path out = OverlayBase(game, out_base);
+    if (IsDir(out)) RemoveStaleOverlays(out);
+    std::vector<std::pair<fs::path, fs::path>> replacements;
+    std::map<std::wstring, std::wstring> owners;
+    if (update) {
+        std::vector<std::pair<fs::path, fs::path>> files;
+        const fs::path root = fs::canonical(*update);
+        Walk(root, root, files, false);
+        for (const auto& [relative, source] : files) {
+            owners[Fold(relative.generic_wstring())] = update->filename().native();
+            replacements.emplace_back(relative, source);
+        }
+        Log("Game update: %s: %zu files over the game", Utf8(update->filename()).c_str(), files.size());
+    }
+    for (const auto& [name, root] : mods) {
+        std::size_t count = 0;
+        for (const auto& [relative, source] : ModFiles(root)) {
+            const std::wstring key = Fold(relative.generic_wstring());
+            if (const auto it = owners.find(key); it != owners.end())
+                Log("Mods: %s: %s -> %s", Utf8(relative).c_str(), Utf8(it->second).c_str(), Utf8(name).c_str());
+            owners[key] = name;
+            replacements.emplace_back(relative, source);
+            ++count;
+        }
+        Log("Mods: %s: %zu files", Utf8(name).c_str(), count);
+    }
+    if (replacements.empty()) return game;
+    fs::create_directories(out);
+    out = fs::canonical(out);
+    const fs::path overlay = MakeTemporary(out);
+    try {
+        for (const fs::path& entry : Entries(game)) Link(overlay / entry.filename(), entry);
+        std::size_t replaced = 0, added = 0;
+        for (const auto& [relative, source] : replacements) {
+            fs::path parent = overlay;
+            std::vector<fs::path> parts(relative.begin(), relative.end());
+            for (std::size_t i = 0; i + 1 < parts.size(); ++i) {
+                parent = Child(parent, parts[i].native());
+                Expand(parent);
+            }
+            const fs::path destination = Child(parent, parts.back().native());
+            if (IsFile(destination) && !IsLink(destination)) {
+                ++replaced;  // a hard link or copy: every file in the overlay is one of ours
+                Unlink(destination);
+            } else if (IsLink(destination) && !IsDir(destination)) {
+                ++replaced;
+                Unlink(destination);
+            } else if (Exists(destination)) {
+                throw Error("File/directory conflict: " + Utf8(relative));
+            } else {
+                ++added;
+            }
+            Link(destination, source);
+        }
+        Log("Mods: %zu game files replaced, %zu added", replaced, added);
+        return overlay;
+    } catch (...) {
+        try {
+            RemoveOverlay(overlay);
+        } catch (...) {
+        }
+        throw;
+    }
+}
+
+} // namespace
+
+void RemoveOverlay(const fs::path& path) {
+    if (IsLink(path) || !IsDir(path)) {
+        if (IsLink(path) || Exists(path)) Unlink(path);
+        return;
+    }
+    for (const fs::path& entry : Entries(path)) RemoveOverlay(entry);
+    if (!RemoveDirectoryW(path.c_str())) throw Error("cannot remove " + Utf8(path));
+}
+
+fs::path BuildModsOverlay(const fs::path& game, const fs::path& out, const fs::path& mods_dir, const fs::path& config,
+                          bool enabled) {
+    std::vector<std::pair<std::wstring, fs::path>> layers;
+    if (enabled) {
+        fs::path legacy = fs::canonical(game);
+        legacy += L"-mods";
+        if (IsDir(legacy)) layers.emplace_back(legacy.filename().native(), legacy);
+        if (IsDir(Child(mods_dir, L"dvdroot_ps4"))) {
+            layers.emplace_back(mods_dir.filename().native(), mods_dir);
+        } else {
+            for (const std::wstring& name : Selected(mods_dir, config)) layers.emplace_back(name, mods_dir / name);
+        }
+    }
+    return BuildOverlay(game, out, layers, UpdateFolder(fs::canonical(game)));
+}
+
+} // namespace start
