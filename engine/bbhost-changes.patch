-void BufferCache::UnmapInPlace(VAddr addr, u64 size) {
-    if (!GuestInPlace() || size == 0) {
-        return;
-    }
-    std::scoped_lock lk{pending_unmaps_mutex};
-    pending_unmaps.emplace_back(addr, size);
-    unmaps_pending.store(true, std::memory_order_release);
