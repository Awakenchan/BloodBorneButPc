+        uid, static_cast<s32>(svc), slotId, npids, /*virtualUsers=*/{}, /*ownerAccountIds=*/{},
+        /*variablesOut=*/variableArray, /*variablesAOut=*/nullptr, static_cast<u64>(arrayLen), ctx);
+    if (submit < 0) {
+        return submit;
+    }
+    return ORBIS_OK;
