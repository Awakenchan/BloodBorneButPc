diff --git a/gpu/shim/bbport_native_calls.cpp b/gpu/shim/bbport_native_calls.cpp
new file mode 100644
index 0000000..0e0e8de
--- /dev/null
+++ b/gpu/shim/bbport_native_calls.cpp
@@ -0,0 +1,233 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: direct calls, stage 2 (see bbport_native_calls.h).
+#include "bbport_native_calls.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+
+namespace BbNativeCalls {
+namespace {
+
+Mode ReadMode() {
+    const char* env = std::getenv("BB_NATIVE_CALLS");
+    if (!env || !env[0] || std::strcmp(env, "0") == 0) {
+        return Mode::Off;
+    }
+    if (std::strcmp(env, "verify") == 0) {
+        return Mode::Verify;
+    }
+    if (std::strcmp(env, "1") == 0) {
+        return Mode::Native;
+    }
+    std::printf("Native calls: BB_NATIVE_CALLS=%s not understood (verify or 1), off\n", env);
+    return Mode::Off;
+}
+
+const char* ModeName(Mode mode) {
+    return mode == Mode::Verify ? "verify" : mode == Mode::Native ? "1" : "off";
+}
+
+/// Records by packet address, direct-mapped (a later call at the same address replaces the
+/// entry; a collision only leaves a draw unverified). Command memory is reused once the GPU is
+/// past it, long after the decode took the entry.
+struct Slot {
+    std::atomic<u32> lock{0};
+    u64 address = 0;
+    DrawRecord record{};
+};
+constexpr u32 SlotBits = 16;
+std::unique_ptr<Slot[]> slots;
+std::atomic<bool> slots_ready{false};
+
+Slot& SlotFor(u64 address) {
+    const u64 h = (address >> 2) * 0x9E3779B97F4A7C15ull;
+    return slots[h >> (64 - SlotBits)];
+}
+
+void Lock(Slot& s) {
+    while (s.lock.exchange(1, std::memory_order_acquire)) {
+        while (s.lock.load(std::memory_order_relaxed)) {
+            __builtin_ia32_pause();
+        }
+    }
+}
+
+void Unlock(Slot& s) {
+    s.lock.store(0, std::memory_order_release);
+}
+
+// Statistics: game threads write the atomics, the GPU thread the plain counters and prints.
+std::atomic<u64> written_records{0}, written_fallback{0};
+u64 verified = 0, mismatches = 0, unrecorded = 0, trace_trailers = 0, decoded = 0;
+u64 window_draws = 0, packet_ticks = 0, draw_ticks = 0, timed_draws = 0;
+u64 window_tsc = 0;
+std::chrono::steady_clock::time_point window_start = std::chrono::steady_clock::now();
+u64 mismatch_logged = 0;
+std::chrono::steady_clock::time_point mismatch_window = std::chrono::steady_clock::now();
+
+const char* KindName(u32 kind) {
+    return kind == DrawAuto ? "drawIndexAuto" : kind == DrawIndex ? "drawIndex"
+           : kind == DrawIndexOffset                              ? "drawIndexOffset"
+                                                                  : "?";
+}
+
+} // namespace
+
+Mode GetMode() {
+    static const Mode mode = [] {
+        const Mode m = ReadMode();
+        if (m == Mode::Verify) {
+            slots = std::make_unique<Slot[]>(std::size_t(1) << SlotBits);
+            slots_ready.store(true, std::memory_order_release);
+        }
+        if (m != Mode::Off) {
+            std::printf("Native calls: BB_NATIVE_CALLS=%s (dcb.drawIndexAuto, drawIndex, "
+                        "drawIndexOffset)\n",
+                        ModeName(m));
+        }
+        return m;
+    }();
+    return mode;
+}
+
+void Remember(u64 address, const DrawRecord& record) {
+    if (!slots_ready.load(std::memory_order_acquire)) {
+        return;
+    }
+    Slot& s = SlotFor(address);
+    Lock(s);
+    s.address = address;
+    s.record = record;
+    Unlock(s);
+}
+
+bool Take(u64 address, DrawRecord& record) {
+    if (!slots_ready.load(std::memory_order_acquire)) {
+        return false;
+    }
+    Slot& s = SlotFor(address);
+    Lock(s);
+    const bool found = s.address == address && s.record.kind != DrawNone;
+    if (found) {
+        record = s.record;
+        s.record.kind = DrawNone;
+    }
+    Unlock(s);
+    return found;
+}
+
+void NoteVerified(bool ok) {
+    ++verified;
+    mismatches += !ok;
+}
+
+void NoteUnrecorded() {
+    ++unrecorded;
+}
+
+void NoteTraceTrailer() {
+    ++trace_trailers;
+}
+
+void ReportMismatch(const char* what, u64 address, const DrawRecord& record, const u32* actual,
+                    u32 words, u32 num_instances) {
+    // The first 16, then one per 5 s.
+    const auto now = std::chrono::steady_clock::now();
+    if (mismatch_logged >= 16) {
+        if (now - mismatch_window < std::chrono::seconds(5)) {
+            return;
+        }
+        mismatch_window = now;
+    }
+    ++mismatch_logged;
+    u32 expected[8]{};
+    const u32 n = EncodeDrawPacket(record, expected);
+    char line[512];
+    int len = std::snprintf(line, sizeof(line),
+                            "Native calls: mismatch (%s) at %#llx: %s count %u offset %u addr %#llx "
+                            "pred %u, instances %u; record",
+                            what, (unsigned long long)address, KindName(record.kind),
+                            record.index_count, record.index_offset,
+                            (unsigned long long)record.index_addr, record.predicate, num_instances);
+    for (u32 k = 0; k < n && len < int(sizeof(line)) - 12; ++k) {
+        len += std::snprintf(line + len, sizeof(line) - len, " %08x", expected[k]);
+    }
+    len += std::snprintf(line + len, sizeof(line) - len, "; decoded");
+    for (u32 k = 0; k < words && len < int(sizeof(line)) - 12; ++k) {
+        len += std::snprintf(line + len, sizeof(line) - len, " %08x", actual[k]);
+    }
+    std::printf("%s\n", line);
+    std::fflush(stdout);
+}
+
+void NoteWritten(bool as_record) {
+    (as_record ? written_records : written_fallback).fetch_add(1, std::memory_order_relaxed);
+}
+
+void NoteDecoded() {
+    ++decoded;
+}
+
+bool TimingEnabled() {
+    static const bool on = std::getenv("BB_FRAME_STATS") != nullptr;
+    return on;
+}
+
+void AddPacketTicks(u64 ticks, bool is_draw) {
+    packet_ticks += ticks;
+    if (is_draw) {
+        draw_ticks += ticks;
+        ++timed_draws;
+    }
+}
+
+void MaybeReport() {
+    const Mode mode = GetMode();
+    const bool timing = TimingEnabled();
+    if (mode == Mode::Off && !timing) {
+        return;
+    }
+    // The clock is read every 256 draws (rdtsc per packet is the only per-draw cost).
+    if ((++window_draws & 255) != 0) {
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    const double secs = std::chrono::duration<double>(now - window_start).count();
+    if (secs < 5.0) {
+        return;
+    }
+    const u64 tsc = Ticks();
+    // Ticks per microsecond over the window (the first window has no start: no timing yet).
+    const double ticks_per_us = window_tsc && tsc > window_tsc ? (tsc - window_tsc) / (secs * 1e6)
+                                                               : 0.0;
+    window_tsc = tsc;
+    window_start = now;
+    char extra[256] = "";
+    if (mode == Mode::Verify) {
+        std::snprintf(extra, sizeof(extra), " (%llu direct draws without a record, %llu thread "
+                      "trace trailers)",
+                      (unsigned long long)unrecorded, (unsigned long long)trace_trailers);
+        std::printf("Native calls: %llu draws verified, %llu mismatches%s\n",
+                    (unsigned long long)verified, (unsigned long long)mismatches, extra);
+    } else if (mode == Mode::Native) {
+        std::printf("Native calls: %llu draws as records (%llu written, %llu kept as PM4)\n",
+                    (unsigned long long)decoded,
+                    (unsigned long long)written_records.exchange(0, std::memory_order_relaxed),
+                    (unsigned long long)written_fallback.exchange(0, std::memory_order_relaxed));
+    }
+    if (timing && ticks_per_us > 0.0 && timed_draws) {
+        std::printf("Native calls (%s) GPU command thread: %.0f draws/s, draw packets %.3f us/draw, "
+                    "all packets %.3f us/draw\n",
+                    ModeName(mode), timed_draws / secs, draw_ticks / ticks_per_us / timed_draws,
+                    packet_ticks / ticks_per_us / timed_draws);
+    }
+    std::fflush(stdout);
+    verified = mismatches = unrecorded = trace_trailers = decoded = 0;
+    packet_ticks = draw_ticks = timed_draws = 0;
+}
+
+} // namespace BbNativeCalls
diff --git a/gpu/shim/bbport_native_calls.h b/gpu/shim/bbport_native_calls.h
new file mode 100644
index 0000000..279ba77
--- /dev/null
+++ b/gpu/shim/bbport_native_calls.h
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: direct calls, stage 2 (docs/EMULATION_REMOVAL_PLAN.ru.md): the game's libGnm draw
+// functions dcb.drawIndexAuto (0x10741b0), dcb.drawIndex (0x1074360) and dcb.drawIndexOffset
+// (0x1074420) hand the GPU thread a record of the call instead of the PM4 it would be decoded from.
+//
+// BB_NATIVE_CALLS unset: nothing changes. =verify: the game's own functions still write their
+// packets; a hook notes each call's record (by the address of the packet it wrote) and the GPU
+// thread compares it with the decode: packet words, register effects, register checksum.
+// =1: the functions are replaced: they reserve the same space through the command buffer's own
+// reserve callback and write one type-3 NOP that carries the record (tag below). The GPU thread
+// applies the record's register effects exactly as the draw packet would (same checksum, same
+// prepared draws) and draws as for DRAW_INDEX_*. A call the record cannot express (a thread trace
+// marker after the draw) keeps the original encoding.
+//
+// The original encodings (1.09 eboot), command buffer flags at cb+0x28:
+//   drawIndexAuto(cb, count):          DRAW_INDEX_AUTO c0012d00|f&1, count, 2              + trailer
+//   drawIndex(cb, count, addr):        DRAW_INDEX_2 c0042700|f&1, count, addr&~1, addr>>32, count, 0
+//                                                                                          + trailer
+//   drawIndexOffset(cb, offset, count): DRAW_INDEX_OFFSET_2 c0033500|f&1, count, offset, count, 0
+//                                                                                          + trailer
+//   trailer: NOP c0001000, 0; or (0x1089c40 true: thread trace) EVENT_WRITE c0004600|f&2, 0x35.
+// Instance counts are not part of these calls (setNumInstances writes its own packet).
+#pragma once
+
+#include <cstdint>
+
+namespace BbNativeCalls {
+using u32 = std::uint32_t;
+using u64 = std::uint64_t;
+
+enum class Mode { Off, Verify, Native };
+/// BB_NATIVE_CALLS: unset/0 off, "verify", 1 native. Read once.
+Mode GetMode();
+
+enum DrawKind : u32 { DrawNone = 0, DrawAuto = 1, DrawIndex = 2, DrawIndexOffset = 3 };
+
+struct DrawRecord {
+    u32 kind = DrawNone;
+    u32 predicate = 0; ///< the draw packet's predicate bit (command buffer flags bit 0)
+    u32 index_count = 0;
+    u32 index_offset = 0; ///< DrawIndexOffset
+    u64 index_addr = 0;   ///< DrawIndex, as passed (the packet clears bit 0)
+};
+
+/// Dwords the game's function reserves and writes: the draw packet and the 2-dword trailer.
+constexpr u32 ReservedDwords(u32 kind) {
+    return kind == DrawAuto ? 5 : kind == DrawIndex ? 8 : kind == DrawIndexOffset ? 7 : 0;
+}
+
+/// The draw packet the game's function writes for `r` (no trailer); its length in dwords.
+inline u32 EncodeDrawPacket(const DrawRecord& r, u32* out) {
+    const u32 pred = r.predicate & 1;
+    switch (r.kind) {
+    case DrawAuto:
+        out[0] = 0xc0012d00u | pred;
+        out[1] = r.index_count;
+        out[2] = 2; // draw initiator: auto index
+        return 3;
+    case DrawIndex:
+        out[0] = 0xc0042700u | pred;
+        out[1] = r.index_count; // max size
+        out[2] = static_cast<u32>(r.index_addr) & ~1u;
+        out[3] = static_cast<u32>(r.index_addr >> 32);
+        out[4] = r.index_count;
+        out[5] = 0;
+        return 6;
+    case DrawIndexOffset:
+        out[0] = 0xc0033500u | pred;
+        out[1] = r.index_count; // max size
+        out[2] = r.index_offset;
+        out[3] = r.index_count;
+        out[4] = 0;
+        return 5;
+    default:
+        return 0;
+    }
+}
+
+/// NOP payload tag: 0xbb5d in the top half (no NOP the game or our driver writes starts so; the
+/// observe statistics list uncovered NOPs by their payload's top nibble), kind in bits 0-7,
+/// predicate in bit 8. The last payload dword is a check over the others, so data the game keeps
+/// in NOPs (allocateFromCommandBuffer) cannot pass for a record.
+constexpr u32 TagMagic = 0xbb5d0000u;
+constexpr u32 TagMask = 0xffff0000u;
+
+inline u32 RecordCheck(const u32* payload, u32 count) {
+    u32 h = 0x5eedbb01u;
+    for (u32 k = 0; k < count; ++k) {
+        h = (h ^ payload[k]) * 16777619u;
+        h ^= h >> 15;
+    }
+    return h;
+}
+
+/// The record NOP for `r`: ReservedDwords(r.kind) dwords (the space the original writes).
+inline u32 EncodeRecordNop(const DrawRecord& r, u32* out) {
+    const u32 n = ReservedDwords(r.kind);
+    if (n == 0) {
+        return 0;
+    }
+    const u32 payload = n - 1;
+    out[0] = 0xc0001000u | ((n - 2) << 16); // type 3, NOP, count = payload - 1
+    u32* p = out + 1;
+    for (u32 k = 0; k < payload; ++k) {
+        p[k] = 0;
+    }
+    p[0] = TagMagic | ((r.predicate & 1) << 8) | r.kind;
+    p[1] = r.index_count;
+    if (r.kind == DrawIndex) {
+        p[2] = static_cast<u32>(r.index_addr);
+        p[3] = static_cast<u32>(r.index_addr >> 32);
+    } else if (r.kind == DrawIndexOffset) {
+        p[2] = r.index_offset;
+    }
+    p[payload - 1] = RecordCheck(p, payload - 1);
+    return n;
+}
+
+/// A record NOP (header at `packet`): fills `r`. Reads only inside the packet.
+inline bool DecodeRecordNop(const u32* packet, DrawRecord& r) {
+    const u32 header = packet[0];
+    // type 3, opcode NOP; count field >= 3 (the smallest record has a 4-dword payload).
+    if ((header >> 30) != 3 || ((header >> 8) & 0xff) != 0x10) {
+        return false;
+    }
+    const u32 count = (header >> 16) & 0x3fff;
+    if (count < 3) {
+        return false;
+    }
+    const u32* p = packet + 1;
+    if ((p[0] & TagMask) != TagMagic || (p[0] & 0xfe00u) != 0) {
+        return false;
+    }
+    const u32 kind = p[0] & 0xff;
+    const u32 n = ReservedDwords(kind);
+    if (n == 0 || count != n - 2) {
+        return false;
+    }
+    const u32 payload = n - 1;
+    if (p[payload - 1] != RecordCheck(p, payload - 1)) {
+        return false;
+    }
+    r.kind = kind;
+    r.predicate = (p[0] >> 8) & 1;
+    r.index_count = p[1];
+    r.index_offset = kind == DrawIndexOffset ? p[2] : 0;
+    r.index_addr = kind == DrawIndex ? (u64(p[3]) << 32 | p[2]) : 0;
+    return true;
+}
+
+/// BB_NATIVE_CALLS=1: record NOPs can be in command buffers (otherwise none is looked for).
+inline bool RecordsEnabled() {
+    static const bool on = GetMode() == Mode::Native;
+    return on;
+}
+/// A record NOP at `packet` (mode 1 only): fills `r`.
+inline bool ReadRecord(const u32* packet, DrawRecord& r) {
+    return RecordsEnabled() && DecodeRecordNop(packet, r);
+}
+inline bool IsRecordNop(const u32* packet) {
+    DrawRecord r;
+    return ReadRecord(packet, r);
+}
+
+// --- verify mode ---
+/// Game threads (the hook after the original function): the record of the packet at `address`.
+void Remember(u64 address, const DrawRecord& record);
+/// GPU thread: the record noted for the draw packet at `address` (taken out of the table).
+bool Take(u64 address, DrawRecord& record);
+
+/// GPU thread: one decoded draw compared (ok: everything matched).
+void NoteVerified(bool ok);
+/// GPU thread: a direct draw without a record (written by another function or our driver).
+void NoteUnrecorded();
+/// GPU thread: the trailer was the thread trace EVENT_WRITE (mode 1 keeps those calls as PM4).
+void NoteTraceTrailer();
+/// GPU thread: prints a mismatch (rate-limited): what differed, the record, the decoded words.
+void ReportMismatch(const char* what, u64 address, const DrawRecord& record, const u32* actual,
+                    u32 words, u32 num_instances);
+
+// --- mode 1 ---
+/// Game threads: a call written as a record NOP, or in its original encoding (fallback).
+void NoteWritten(bool as_record);
+/// GPU thread: a record NOP drawn.
+void NoteDecoded();
+
+// --- BB_FRAME_STATS: GPU command thread cost per draw ---
+bool TimingEnabled();
+inline u64 Ticks() {
+    return __builtin_ia32_rdtsc();
+}
+/// GPU thread: per type-3 packet (not IBs) its handling time; draws counted separately.
+void AddPacketTicks(u64 ticks, bool is_draw);
+/// GPU thread, after each direct draw: prints every 5 s ("Native calls: ...").
+void MaybeReport();
+} // namespace BbNativeCalls
