-    auto read_desc = VideoCore::TextureCache::ImageDesc(
-        regs.depth_buffer, regs.depth_view, regs.depth_control,
-        regs.depth_htile_data_base.GetAddress(), DbExtent(), false);
-    auto write_desc = VideoCore::TextureCache::ImageDesc(
-        regs.depth_buffer, regs.depth_view, regs.depth_control,
