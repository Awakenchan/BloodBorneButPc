-
-    totalLength = strnlen(url, 0x3fff);
-    baseUrlLength = strnlen(relativeUri, 0x3fff);
-    combinedLength = totalLength + 1 + baseUrlLength;
-    relativeUriLength = prepare - combinedLength;
