+             "variablesSize = {}, arrayLen = {}, option = {}",
+             reqId, virtualUserId ? virtualUserId->data : "", fmt::ptr(slotIds),
+             fmt::ptr(variableArray), variablesSize, arrayLen, fmt::ptr(option));
