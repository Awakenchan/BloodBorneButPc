+    for (size_t i=0;i<n;++i) if (!isalnum((unsigned char)label[i])) return;
+    for (uint32_t i=0;i<addon_count;++i) if (!strcmp(addon_labels[i],label)) return;
+    memcpy(addon_labels[addon_count++],label,n+1);
