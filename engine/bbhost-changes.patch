+s32 PS4_SYSV_ABI net_accept(int s, void* addr, unsigned* addrlen) {
+    std::lock_guard lk(g_net_mu);
+    if (!g_socks.count(s)) return net_err(EBADF);
+    if (addr && addrlen && *addrlen >= 16) {
+        std::uint8_t sa[16]{};
+        sa[0] = 16;
+        sa[1] = 2;
+        std::memcpy(addr, sa, 16);
+        *addrlen = 16;
+    }
+    const int id = g_net_next++;
+    g_socks[id] = NetSock{};
+    return id;
