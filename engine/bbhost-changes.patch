+    }
+    s32 ids[2];
+    const auto r = Core::Net::SocketCreatePair(kind->family, kind->type, kind->protocol, ids);
+    if (r.error != Error::Ok) {
+        return PosixError(ToOrbisErrno(r.error));
+    }
+    sv[0] = ids[0];
+    sv[1] = ids[1];
+    return 0;
