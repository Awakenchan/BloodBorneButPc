+
+// Backends:
+//  * Linux:          poll + eventfd, epoll
+//  * macOS/FreeBSD:  poll + pipe, kqueue
+//  * Windows:        WSAPoll + loopback UDP pair, wepoll
+
+#pragma once
+
+#include <chrono>
+#include <cstddef>
+#include <optional>
+#include <span>
+
+#include "common/types.h"
+
+#ifdef _WIN32
+#include <winsock2.h>
