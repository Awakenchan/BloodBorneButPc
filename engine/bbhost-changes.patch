+s32 PS4_SYSV_ABI sceNpSignalingDeactivateConnection(OrbisNpSignalingContextId ctxId,
+                                                    OrbisNpSignalingConnectionId connId) {
+    {
+        SignalingMutexGuard lock;
+        if (!NpHandler::GetInstance().GetSignalingState().initialized) {
