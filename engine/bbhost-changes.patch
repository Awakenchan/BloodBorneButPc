+bool Rasterizer::HonestLabels() {
+    static const bool on = [] {
+        const char* env = std::getenv("BB_HONEST_LABELS");
+        const bool enabled = (env && env[0] == '1') || VideoCore::GuestInPlace();
+        if (enabled) {
