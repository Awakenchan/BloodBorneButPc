+s32 PS4_SYSV_ABI m2_get_world_info_list(unsigned ctx, const void*, const RequestOptParam* opt, unsigned* req_out) {
+    std::lock_guard lk(g.mu);
+    if (ctx != g.ctx_id) return kErrContext;
+    const unsigned req = g.next_req++;
