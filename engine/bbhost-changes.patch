-bool IsFollowableRedirect(int status, s32 method) {
-    const bool status_in_set = (status >= 300 && status <= 303) || (status == 307);
-    if (!status_in_set) {
-        return false;
-    }
-    if (method == ORBIS_HTTP_METHOD_POST && status != 303) {
-        return false;
-    }
-    return true;
-}
