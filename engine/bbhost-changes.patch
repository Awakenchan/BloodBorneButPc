+    Impl(const Instance& instance_, Scheduler& scheduler_)
+        : instance{instance_}, scheduler{scheduler_} {}
+
+    void Fail(std::string why, bool permanent) {
+        if (problem != why) {
+            std::printf("DLSS: %s\n", why.c_str());
