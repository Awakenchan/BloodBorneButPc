-namespace {
-// BB_SECTIONS: ordered tasks by function (cycles, count), stage B only.
-constexpr std::size_t TaskKinds = 16;
-std::array<void*, TaskKinds> task_kinds{};
-std::array<u64, TaskKinds> task_cycles{}, task_counts{};
