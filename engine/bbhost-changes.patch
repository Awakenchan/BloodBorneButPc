+StreamSocket::StreamSocket(std::shared_ptr<Transport> transport,
+                           std::shared_ptr<Readiness> readiness)
+    : transport_(std::move(transport)),
+      readiness_(readiness ? std::move(readiness) : std::make_shared<Readiness>()) {}
