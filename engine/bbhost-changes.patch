+void NpHandler::SetAppearOffline(bool enable) {
+    m_appear_offline = enable;
+    std::lock_guard lock(m_mutex_clients);
+    for (auto& [uid, client] : m_clients) {
+        if (client)
+            client->SetAppearOffline(enable); // sends the toggle to connected sessions
+    }
+}
