+    std::shared_ptr<NpTus::TusRequestCtx> ctx, NpTus::OrbisNpTusVariableA* variablesAOut,
+    s64 ownerAccountId, NpTus::OrbisNpTusVariableForCrossSave* variablesCSOut) {
+    std::shared_ptr<ShadNet::ShadNetClient> client;
