+s32 PS4_SYSV_ABI ctl_nat(void* info) {
+    if (info) {
+        const int stun = 1, nat = 1;
+        const std::uint32_t addr = bswap32(0x7f000001u);
+        auto* p = static_cast<std::uint8_t*>(info);
+        std::memcpy(p, &stun, 4);
+        std::memcpy(p + 4, &nat, 4);
+        std::memcpy(p + 8, &addr, 4);
+    }
+    return 0;
+}
