+
+int PS4_SYSV_ABI sys_connect(OrbisNetId s, const OrbisNetSockaddr* addr, u32 addrlen) {
+    const KeepNetErrno keep;
+    return static_cast<int>(Posix(sceNetConnect(s, addr, addrlen)));
+}
