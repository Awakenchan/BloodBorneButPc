+def fmg_write(rows):
+    order=sorted(rows);groups=[]
+    for i,mid in enumerate(order):
+        if not i or mid!=order[i-1]+1:groups.append([i,mid,mid,0])
+        else:groups[-1][2]=mid
+    off=40+16*len(groups);body=off+8*len(order);out=bytearray(body);pool={}
+    out[2]=2;struct.pack_into('<IIII',out,8,1,len(groups),len(order),255);struct.pack_into('<Q',out,24,off)
+    for i,g in enumerate(groups):struct.pack_into('<iiii',out,40+i*16,*g)
+    for i,mid in enumerate(order):
+        text=rows[mid]
+        if text is None:continue
+        if text not in pool:pool[text]=len(out);out+=text.encode('utf-16-le')+b'\0\0'
+        struct.pack_into('<Q',out,off+i*8,pool[text])
+    struct.pack_into('<I',out,4,len(out));return bytes(out)
