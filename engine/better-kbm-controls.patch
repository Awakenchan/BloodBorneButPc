+def u32(b,o): return struct.unpack_from('<I',b,o)[0]
+def u64(b,o): return struct.unpack_from('<Q',b,o)[0]
+def fmg_read(b):
+    if len(b)<40 or b[2]!=2: raise ValueError('Unsupported FMG')
+    count,total,off=u32(b,12),u32(b,16),u64(b,24); rows={}
+    if 40+count*16>len(b) or off+total*8>len(b): raise ValueError('Truncated FMG')
+    for g in range(count):
+        idx,first,last=struct.unpack_from('<iii',b,40+16*g)
+        if idx<0 or last<first or idx+last-first>=total: raise ValueError('Invalid FMG group')
+        for k,mid in enumerate(range(first,last+1)):
+            pos=u64(b,off+(idx+k)*8)
+            if not pos: rows[mid]=None;continue
+            end=pos
+            while end+2<=len(b) and b[end:end+2]!=b'\0\0':end+=2
+            if end+2>len(b):raise ValueError('Unterminated FMG string')
+            rows[mid]=b[pos:end].decode('utf-16-le')
+    return rows
