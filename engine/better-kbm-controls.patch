-    injected.touch_side=-1;
-    for (int i=0;i<4;++i) injected.stick[i]=-1;
-    char token[64];
-    while (fscanf(f,"%63s",token)==1) {
-        if (!strcmp(token,"replay") && replay_armed!=1) { replay_armed=1; replay_start=0; } /* BB_PAD_REPLAY */
