+    SDL_GUIDToString(SDL_GetGamepadGUIDForID(id),guid,sizeof guid);
+    const char *name=SDL_GetGamepadNameForID(id);
+    return !SDL_strcasecmp(guid,want) || (name && SDL_strcasestr(name,want));
