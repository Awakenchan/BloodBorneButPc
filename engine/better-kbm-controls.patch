+                        temporary.write_bytes(quit_menu.menu_texts(localized,quit_menu.TEXTS.get(relative.parent.name,quit_menu.TEXTS['engus'])))
                 current = sha(temporary.read_bytes())
                 os.replace(temporary, destination)
             finally:
                 temporary.unlink(missing_ok=True)
+        else:
+            reused+=1
         rows[relative.as_posix()] = {'input': digest, 'output': current}
     root.mkdir(parents=True, exist_ok=True)
     temporary = manifest_path.with_suffix(f'.{os.getpid()}.tmp')
     temporary.write_text(json.dumps({'generator': generator, 'files': rows}, indent=2), encoding='utf-8')
     os.replace(temporary, manifest_path)
+    print(f'Startup: menu resources: {reused} reused, {rebuilt} regenerated ({time.monotonic()-started:.3f} s)',flush=True)
     return root.resolve()
