+    if raw[:4]!=b'BND4' or len(raw)<64:raise ValueError('Unsupported BND4')
+    count=u32(raw,12);esize=u64(raw,32)
+    if esize<36 or 64+count*esize>len(raw):raise ValueError('Invalid BND4 headers')
+    entries=[];names=bytearray();blobs=bytearray();base=64+count*esize;changed=False
+    for i in range(count):
+        h=bytearray(raw[64+i*esize:64+(i+1)*esize]);size,off,group,name=u64(h,8),u32(h,24),u32(h,28),u32(h,32)
+        if off+size>len(raw) or name>=len(raw):raise ValueError('Invalid BND4 entry')
+        end=name;step=2 if raw[48] else 1
+        while end+step<=len(raw) and any(raw[end:end+step]):end+=step
+        if end+step>len(raw):raise ValueError('Invalid BND4 name')
+        struct.pack_into('<I',h,32,base+len(names));names+=raw[name:end+step]
+        data=raw[off:off+size]
+        if group in (200,201,78,204,30):
+            rows=fmg_read(data)
+            before=dict(rows)
+            if catalog:
+                for mid,(text,helptext) in catalog.items():
+                    if mid in rows:rows[mid]=helptext if group==201 else text
+            if group==30 and 70000006 in rows and mirror is not None:rows[70000006]=mirror
+            if rows!=before:data=fmg_write(rows);changed=True
+        entries.append((h,data))
+    if not changed:return raw
+    start=base+len(names);out=bytearray(raw[:64]);struct.pack_into('<Q',out,40,start)
