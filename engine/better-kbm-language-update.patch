diff --git a/gpu/shim/engine/game_language.h b/gpu/shim/engine/game_language.h
new file mode 100644
--- /dev/null
+++ b/gpu/shim/engine/game_language.h
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <cstdlib>
+namespace GameLanguage {
+struct Site {std::size_t at;std::array<std::uint8_t,5> expected;};
+// Both reads of Localize.VoiceLang: boot localization and the property accessor.
+// Their integer result goes through the game's original region/voice-track mapping.
+inline constexpr Site sites[] = {
+    {0x1fb6ee4,{0xe8,0x17,0x4b,0x13,0x00}},
+    {0x2001b85,{0xe8,0x76,0x9e,0x0e,0x00}},
+};
+inline int Parse(const char* text) {
+    if(!text||!*text)return -1;
+    char* end=nullptr;const long value=std::strtol(text,&end,10);
+    if(*end)return -1;
+    switch(value){case 0:case 1:case 2:case 3:case 4:case 5:case 17:return int(value);default:return -1;}
+}
+template<class Writer>
+bool Apply(std::uint8_t* image,std::size_t size,int language,Writer write) {
+    if(language<0)return false;
+    for(const auto& site:sites) {
+        if(site.at>size||site.expected.size()>size-site.at||
+           std::memcmp(image+site.at,site.expected.data(),site.expected.size()))return false;
+    }
+    // mov eax, language replaces only the property read. Text, subtitles and
+    // item descriptions continue to use the independent platform text language.
+    const std::array<std::uint8_t,5> replacement={0xb8,std::uint8_t(language),0,0,0};
+    std::size_t committed=0;
+    for(const auto& site:sites) {
+        if(!write(image+site.at,replacement.data(),replacement.size())) {
+            // Restore every attempted site, including a writer's partial failure.
+            for(std::size_t i=0;i<=committed;++i)
+                write(image+sites[i].at,sites[i].expected.data(),sites[i].expected.size());
+            return false;
+        }
+        ++committed;
+    }
+    return true;
+}
+}
