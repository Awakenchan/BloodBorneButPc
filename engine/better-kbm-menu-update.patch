+    int online=0;
+    for (size_t i=0;i<sizeof(prefixes)/sizeof(*prefixes);++i)
+        if (!strncmp(symbol,prefixes[i],strlen(prefixes[i]))) online=1;
+    for (size_t i=0;i<sizeof(local)/sizeof(*local);++i)
+        if (!strncmp(symbol,local[i],strlen(local[i]))) online=0;
+    return online;
