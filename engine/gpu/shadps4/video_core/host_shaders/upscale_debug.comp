// bbport: the menu's debug views over an upscaled output in place, for the scaled path (an output
// other than 1080p: TemporalUpscaler::RunScaled), where upscale_merge.comp does not run. The same
// modes: 1 the reactive mask in red over a darkened frame, 2 the motion vectors (red/green:
// |x|/|y|, 8 render pixels = full; blue: an object motion vector). LDR_OUTPUT: the 8-bit UI image
// (FSR 3.1), else the RGBA16F output (FSR 4, DLSS, TAA), encoded like the UI image by then.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

#ifdef LDR_OUTPUT
layout(binding = 0, rgba8) uniform image2D target;
#else
layout(binding = 0, rgba16f) uniform image2D target;
#endif
layout(binding = 1) uniform texture2D reactive; // R8, render size
layout(binding = 2) uniform texture2D motion;   // render size, pixels
layout(binding = 3) uniform texture2D objects;  // render size, b = object vector written

layout(push_constant) uniform Params {
    uint mode;
    uint render_width;
    uint render_height;
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(target);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    // The scene fills the top-left render_width x render_height of the render-size images.
    const ivec2 render = ivec2(render_width, render_height);
    const ivec2 source = min(pixel * render / size, render - 1);
    const vec4 original = imageLoad(target, pixel);
    vec3 color = clamp(original.rgb, vec3(0.0), vec3(1.0));
    if (mode == 1) {
        const ivec2 mask_size = textureSize(reactive, 0);
        const float mask = texelFetch(reactive, min(source, mask_size - 1), 0).r;
        color = mix(color * 0.25, vec3(1.0, 0.0, 0.0), mask);
    } else if (mode == 2) {
        const ivec2 motion_size = textureSize(motion, 0);
        const ivec2 at = min(source, motion_size - 1);
        const vec2 mv = texelFetch(motion, at, 0).rg;
        const bool object = textureSize(objects, 0) == motion_size && texelFetch(objects, at, 0).b > 0.99;
        const float luma = dot(color, vec3(0.3, 0.6, 0.1));
        color = vec3(luma * 0.3) + vec3(clamp(abs(mv) / 8.0, 0.0, 1.0), object ? 0.6 : 0.0);
    }
    imageStore(target, pixel, vec4(color, original.a));
}
