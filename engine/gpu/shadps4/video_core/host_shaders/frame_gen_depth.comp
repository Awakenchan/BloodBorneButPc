// bbport: frame generation (vk_frame_generation.h): the scene depth copied into the R32F image
// FSR's frame interpolation reads (a depth format cannot be copied into a colour one directly).
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D depth_tex; // depth aspect
layout(binding = 1, r32f) uniform writeonly image2D out_depth;

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(out_depth)))) {
        return;
    }
    imageStore(out_depth, pixel, vec4(texelFetch(depth_tex, pixel, 0).r));
}
